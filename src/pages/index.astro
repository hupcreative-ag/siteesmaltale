---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHome from '../components/home/HeroHome.astro';
import Servicos from '../components/home/Servicos.astro';
import SobreResumo from '../components/home/SobreResumo.astro';
import Unidades from '../components/home/Unidades.astro';
import { totalUnidades, porExtenso, listaCidades } from '../lib/unidades';

// Sem faixa de contato na Home: cada unidade já tem o botão de WhatsApp.
const descricao = `Manicure, pedicure, nail art e podologia em ${porExtenso(totalUnidades)} unidades nos principais shoppings de ${listaCidades}. Agende online.`;
---

<BaseLayout title="Esmaltale | Esmalteria em Salvador e Lauro de Freitas" description={descricao}>
  <HeroHome />
  <Servicos />
  <SobreResumo />
  <Unidades />
</BaseLayout>
