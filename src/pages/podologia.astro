---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroInternal from '../components/sections/HeroInternal.astro';
import type { ImageMetadata } from 'astro';
import IconArrow from '../components/icons/IconArrow.astro';
import Brilhos from '../components/sections/Brilhos.astro';
import { unidadesAtivas, listaCidades } from '../lib/unidades';
import { breadcrumb, servico } from '../lib/schema';
import podologia01 from '../assets/podologia/podologia-01.jpg';
import podologia02 from '../assets/podologia/podologia-02.jpg';
import encerramento from '../assets/podologia/podologia-encerramento.jpg';

const titulo = `Podologia em ${listaCidades} | Esmaltale`;
const descricao =
  'Tratamento de unhas encravadas, calos, fissuras, micoses e bolhas com profissionais treinadas e instrumentos esterilizados em autoclave.';
const intro =
  'Os pés carregam o peso do dia todo e merecem o mesmo cuidado que qualquer outra parte do corpo. Podologia não é estética: é saúde. Na Esmaltale, o serviço é realizado por profissionais treinadas para identificar, tratar e prevenir problemas reais.';

// Fotos ilustrativas dos tratamentos: basta salvar em src/assets/podologia/ com o nome de `arquivo`.
// Enquanto a foto não existe, o card usa o gradiente da marca e mostra o nome esperado.
const FOTOS = import.meta.glob<{ default: ImageMetadata }>('../assets/podologia/tratamento-*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const foto = (arquivo: string) =>
  Object.entries(FOTOS).find(([caminho]) => caminho.split('/').pop()?.replace(/\.\w+$/, '') === arquivo)?.[1].default;

const TRATAMENTOS = [
  {
    nome: 'Unhas encravadas',
    texto: 'Tratamento do encravamento sem cirurgia, com técnica adequada para cada grau de severidade e orientação para prevenção.',
    arquivo: 'tratamento-unhas-encravadas',
    alt: 'Podóloga de luvas tratando a lateral da unha do dedão de uma cliente',
  },
  {
    nome: 'Calos e hiperqueratose',
    texto: 'Remoção segura de calos, durezas e pele grossa nas regiões de pressão dos pés.',
    arquivo: 'tratamento-calos',
    alt: 'Podóloga de luvas lixando a sola do pé de uma cliente',
  },
  {
    nome: 'Fissuras e rachaduras',
    texto: 'Tratamento de fissuras nos calcanhares com hidratação profunda e remoção da pele seca acumulada.',
    arquivo: 'tratamento-fissuras',
    alt: 'Mãos de luvas aplicando creme hidratante no calcanhar de uma cliente',
  },
  {
    nome: 'Infecções e micoses',
    texto:
      'Identificação e manejo inicial de micoses nas unhas e entre os dedos, com orientação sobre cuidados e encaminhamento quando necessário.',
    arquivo: 'tratamento-micoses',
    alt: 'Podóloga de luvas examinando as unhas do pé de uma cliente com lupa',
  },
  {
    nome: 'Bolhas e úlceras',
    texto: 'Cuidado com lesões nos pés com protocolo de higiene rigoroso.',
    arquivo: 'tratamento-bolhas',
    alt: 'Instrumentos esterilizados e gaze sobre bandeja ao lado do pé de uma cliente',
  },
].map((t) => ({ ...t, imagem: foto(t.arquivo) }));

// "em Salvador ou em Lauro de Freitas", a partir das cidades das unidades ativas
const cidadesOu = [...new Set(unidadesAtivas.map((u) => u.cidade))].join(' ou em ');

const schema = [
  breadcrumb([{ nome: 'Podologia', caminho: '/podologia/' }]),
  servico('Podologia', intro, '/podologia/', {
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Tratamentos de podologia',
      itemListElement: TRATAMENTOS.map((t) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: t.nome, description: t.texto },
      })),
    },
  }),
];
---

<BaseLayout title={titulo} description={descricao} schema={schema} contactStrip>
  <HeroInternal titulo="Podologia" trilha="Podologia">
    <p class="podologia-intro">{intro}</p>
    <div class="hero-internal__acoes">
      <button type="button" class="btn-seta" data-booking data-booking-origem="pagina_servico">
        Agendar agora
        <span class="btn-seta__circulo" aria-hidden="true"><IconArrow size={18} /></span>
      </button>
    </div>

    <div slot="media" class="composicao">
      <Picture
        src={podologia02}
        width={800}
        height={960}
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 380px, 62vw"
        formats={['avif', 'webp']}
        alt="Podóloga atendendo uma cliente em uma unidade Esmaltale"
        class="composicao__principal"
        loading="eager"
        fetchpriority="high"
      />
      <Picture
        src={podologia01}
        width={560}
        height={560}
        widths={[280, 420, 560]}
        sizes="(min-width: 1024px) 240px, 40vw"
        formats={['avif', 'webp']}
        alt="Procedimento de podologia com lixa elétrica e luvas descartáveis"
        class="composicao__detalhe"
        loading="eager"
      />
      <Brilhos
        class="composicao__brilhos"
        itens={[
          { x: '10%', y: '8%', t: 20, d: 0 },
          { x: '98%', y: '4%', t: 12, d: 1.3 },
          { x: '102%', y: '44%', t: 18, d: 2.1 },
          { x: '4%', y: '52%', t: 10, d: 0.7 },
          { x: '62%', y: '99%', t: 14, d: 2.8 },
          { x: '94%', y: '86%', t: 9, d: 3.5 },
        ]}
      />
    </div>
  </HeroInternal>

  <!-- O que tratamos: cards com foto de fundo (bento no desktop, carrossel no celular) -->
  <section class="section section--white" aria-labelledby="tratamos-titulo">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title" id="tratamos-titulo">O que tratamos</h2>
      </div>
      <ul class="tratamentos" data-reveal-stagger="90">
        {
          TRATAMENTOS.map(({ nome, texto, arquivo, alt, imagem }, n) => (
            <li class="tratamento" data-reveal>
              {imagem ? (
                <Picture
                  src={imagem}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1024px) 420px, 84vw"
                  formats={['avif', 'webp']}
                  alt={alt}
                  class="tratamento__img"
                  loading="lazy"
                />
              ) : (
                <div class="tratamento__img tratamento__vazio brand-gradient">
                  <span class="img-placeholder tratamento__arquivo">{arquivo}.jpg</span>
                </div>
              )}
              <div class="tratamento__corpo">
                <span class="tratamento__num" aria-hidden="true">
                  {String(n + 1).padStart(2, '0')}
                </span>
                <h3 class="tratamento__nome">{nome}</h3>
                <p class="tratamento__texto">{texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Por que fazer Podologia na Esmaltale -->
  <section class="section section--neutral porque" aria-labelledby="porque-titulo">
    <div class="container porque__grid">
      <div class="porque__media" data-reveal>
        <Picture
          src={encerramento}
          width={800}
          height={1000}
          widths={[400, 640, 800]}
          sizes="(min-width: 1024px) 460px, 92vw"
          formats={['avif', 'webp']}
          alt="Podóloga tratando o calcanhar de uma cliente com lixa elétrica, em sala preparada para o procedimento"
          class="porque__img"
          loading="lazy"
        />
      </div>
      <div class="porque__texto" data-reveal style="--reveal-delay: 120ms">
        <h2 class="section-title" id="porque-titulo">Por que fazer Podologia na Esmaltale</h2>
        <p>
          A podologia exige um nível de cuidado que vai além do equipamento certo. Na Esmaltale, todos os instrumentos
          utilizados nos procedimentos são esterilizados em autoclave antes de cada atendimento, seguindo os protocolos de
          biossegurança que o serviço exige. O ambiente é preparado especificamente para a realização dos procedimentos,
          com organização e higiene em cada etapa.
        </p>
        <p>
          Para quem busca podologia em {cidadesOu}, a Esmaltale oferece um atendimento clínico realizado em espaço
          adequado, por profissionais treinadas e com os padrões de segurança necessários para um procedimento feito com
          responsabilidade.
        </p>
        <button type="button" class="btn-seta porque__cta" data-booking data-booking-origem="pagina_servico">
          Agendar agora
          <span class="btn-seta__circulo" aria-hidden="true"><IconArrow size={18} /></span>
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Composição do hero ---------- */
  .composicao {
    position: relative;
    max-width: 460px;
    margin-inline: auto;
    padding: 0 0 48px 18%;
  }

  .composicao :global(.composicao__principal) {
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    border-radius: 24px;
    box-shadow: 0 30px 60px -30px rgba(54, 33, 58, 0.45);
  }

  .composicao :global(.composicao__detalhe) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 46%;
    aspect-ratio: 1;
    object-fit: cover;
    border: 6px solid var(--color-white);
    border-radius: 20px;
    box-shadow: 0 20px 40px -20px rgba(54, 33, 58, 0.45);
  }

  .composicao :global(.composicao__brilhos) {
    z-index: 1;
  }

  /* ---------- O que tratamos ---------- */
  .tratamentos {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 84%;
    gap: 12px;
    margin-inline: calc(-1 * var(--gutter));
    padding: 4px var(--gutter) 8px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    list-style: none;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .tratamentos::-webkit-scrollbar {
    display: none;
  }

  .tratamento {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: 420px;
    overflow: hidden;
    border-radius: 24px;
    scroll-snap-align: start;
  }

  .tratamento :global(.tratamento__img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out-expo);
  }

  /* Véu escuro de baixo para cima: o texto branco fica legível sobre qualquer foto */
  .tratamento::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      0deg,
      rgba(54, 33, 58, 0.88) 0%,
      rgba(54, 33, 58, 0.6) 42%,
      rgba(54, 33, 58, 0) 78%
    );
  }

  .tratamento__arquivo {
    position: absolute;
    top: 16px;
    left: 16px;
    width: auto;
    height: auto;
    min-height: 0;
    padding: 6px 10px;
    font-size: 0.7rem;
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
  }

  .tratamento__corpo {
    padding: 24px 24px 26px;
    color: var(--color-white);
  }

  .tratamento__num {
    display: inline-block;
    margin-bottom: 14px;
    padding: 4px 12px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    background-color: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .tratamento__nome {
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .tratamento__texto {
    max-width: 44ch;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
  }

  @media (hover: hover) and (pointer: fine) {
    .tratamento:hover :global(.tratamento__img) {
      transform: scale(1.05);
    }
  }

  /* Tablet: 2 colunas, o primeiro card na largura toda */
  @media (min-width: 640px) {
    .tratamentos {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }

    .tratamento {
      min-height: 340px;
    }

    .tratamento:first-child {
      grid-column: span 2;
      min-height: 400px;
    }
  }

  /* Desktop: bento, o primeiro card alto à esquerda e os outros quatro em 2 x 2 */
  @media (min-width: 1024px) {
    .tratamentos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 320px;
    }

    .tratamento,
    .tratamento:first-child {
      min-height: 0;
    }

    .tratamento:first-child {
      grid-column: auto;
      grid-row: span 2;
    }

    .tratamento:first-child .tratamento__corpo {
      padding: 36px;
    }

    .tratamento:first-child .tratamento__nome {
      font-size: 2.25rem;
    }
  }

  /* ---------- Por que ---------- */
  .porque__grid {
    display: grid;
    gap: 36px;
    align-items: center;
  }

  .porque__media {
    overflow: hidden;
    border-radius: 24px;
  }

  .porque__media :global(.porque__img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 60%;
  }

  .porque__texto .section-title {
    margin-bottom: 20px;
  }

  .porque__texto p {
    max-width: 58ch;
    margin-bottom: 16px;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  .porque__cta {
    margin-top: 16px;
  }

  @media (max-width: 1023px) {
    .porque__media :global(.porque__img) {
      aspect-ratio: 4 / 3;
    }
  }

  @media (min-width: 1024px) {
    .porque__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 72px;
    }
  }

  /* No celular o hero fica só com o título (maior) e as fotos ocupando a largura toda; texto e botão continuam no desktop.
     No fim do arquivo e com o seletor do hero na frente para vencer os estilos do HeroInternal. */
  @media (max-width: 767px) {
    :global(.hero-internal__frame .hero-internal__texto) .podologia-intro,
    :global(.hero-internal__frame .hero-internal__texto) .hero-internal__acoes {
      display: none;
    }

    :global(.hero-internal__frame .hero-internal__texto .hero-internal__title) {
      font-size: 3.1rem;
    }

    /* Recuo menor à esquerda: a foto principal cresce e a de detalhe continua sobreposta */
    .composicao {
      max-width: none;
      margin-top: -8px;
      padding-left: 10%;
    }
  }
</style>
