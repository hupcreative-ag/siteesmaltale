---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroInternal from '../components/sections/HeroInternal.astro';
import CtaFinal from '../components/sections/CtaFinal.astro';
import MosaicoLojas from '../components/sections/MosaicoLojas.astro';
import Brilhos from '../components/sections/Brilhos.astro';
import { SITE } from '../config/site';
import { totalUnidades, porExtenso, listaNomes } from '../lib/unidades';
import { breadcrumb, pagina } from '../lib/schema';
import sobrePagina from '../assets/sobre/sobre-pagina.jpg';
import missao from '../assets/sobre/missao.jpg';
import visao from '../assets/sobre/visao.jpg';
import clienteMaos from '../assets/sobre/cliente-maos.webp';
import IconCuidado from '../components/icons/IconCuidado.astro';
import IconExcelencia from '../components/icons/IconExcelencia.astro';
import IconHigiene from '../components/icons/IconHigiene.astro';
import IconAmbiente from '../components/icons/IconAmbiente.astro';
import IconProfissionais from '../components/icons/IconProfissionais.astro';
import IconSocial from '../components/icons/IconSocial.astro';

const titulo = 'Sobre a Esmaltale | Esmalteria em Salvador desde 2017';
const descricao = `Conheça a Esmaltale: esmalteria fundada em ${SITE.fundacao} em Salvador, com ${porExtenso(totalUnidades)} unidades, esterilização em autoclave e ambiente acolhedor.`;

const VALORES = [
  { nome: 'Cuidado com o outro', Icone: IconCuidado },
  { nome: 'Excelência técnica', Icone: IconExcelencia },
  { nome: 'Higiene como compromisso', Icone: IconHigiene },
  { nome: 'Ambiente que acolhe', Icone: IconAmbiente },
  { nome: 'Valorização das profissionais', Icone: IconProfissionais },
  { nome: 'Comprometimento social', Icone: IconSocial },
];

const schema = [pagina('AboutPage', '/sobre/', 'Sobre a Esmaltale', descricao), breadcrumb([{ nome: 'Sobre', caminho: '/sobre/' }])];
---

<BaseLayout title={titulo} description={descricao} schema={schema} contactStrip>
  <HeroInternal titulo="Sobre a Esmaltale" trilha="Sobre" midiaSangrada>
    <p>A Esmaltale nasceu em Salvador em 2017 com uma convicção: cuidar das unhas é cuidar de si.</p>
    <MosaicoLojas slot="media" />
  </HeroInternal>

  <!-- Texto institucional -->
  <section class="section section--white historia" aria-labelledby="historia-titulo">
    <div class="container historia__grid">
      <div class="historia__media" data-reveal>
        <Picture
          src={sobrePagina}
          width={1200}
          height={1350}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 520px, 92vw"
          formats={['avif', 'webp']}
          alt="Cliente escolhendo um esmalte na prateleira de uma unidade Esmaltale"
          class="historia__img"
          loading="lazy"
        />
      </div>
      <div class="historia__texto" data-reveal style="--reveal-delay: 120ms">
        <h2 class="section-title" id="historia-titulo">Nossa história</h2>
        <p>
          Começamos com uma unidade. Hoje são {porExtenso(totalUnidades)}, nos principais shoppings da cidade: {listaNomes}.
        </p>
        <p>
          Em cada uma delas, o padrão não muda: o ambiente é pensado para o seu conforto, os instrumentos passam pela
          autoclave antes de qualquer atendimento e o agendamento é online para encaixar em qualquer momento do seu dia.
        </p>
        <p>
          O que a gente oferece vai além da manicure. Alongamentos, nail art, spa das mãos e dos pés, podologia e um
          cuidado completo para quem quer se sentir bem de verdade.
        </p>
      </div>
    </div>
  </section>

  <section class="citacao" aria-label="Nossa proposta">
    <div class="container">
      <blockquote class="citacao__texto" data-reveal>
        <svg class="citacao__brilhos" viewBox="0 0 64 24" aria-hidden="true" focusable="false">
          <path d="M12 4c.6 3.6 1.9 5 5.4 5.6-3.5.6-4.8 2-5.4 5.6-.6-3.6-1.9-5-5.4-5.6 3.5-.6 4.8-2 5.4-5.6z" />
          <path d="M32 0c.9 5.4 2.9 7.5 8.1 8.4-5.2.9-7.2 3-8.1 8.4-.9-5.4-2.9-7.5-8.1-8.4 5.2-.9 7.2-3 8.1-8.4z" />
          <path d="M52 4c.6 3.6 1.9 5 5.4 5.6-3.5.6-4.8 2-5.4 5.6-.6-3.6-1.9-5-5.4-5.6 3.5-.6 4.8-2 5.4-5.6z" />
        </svg>
        <p>
          Cada visita é pensada para ser uma pausa real. Uma hora em que o dia para, as mãos descansam e você sai diferente
          de como entrou. É isso que a Esmaltale entrega e é por isso que nós estamos aqui.
        </p>
      </blockquote>
    </div>
  </section>

  <!-- Missão e Visão: a foto é só fundo, o texto é o protagonista -->
  <section class="section section--neutral" aria-label="Missão e visão">
    <div class="container mv" data-reveal-stagger="140">
      <article class="mv__cartao" data-reveal>
        <Picture
          src={missao}
          width={900}
          height={600}
          widths={[480, 720, 900]}
          sizes="(min-width: 900px) 600px, 92vw"
          formats={['avif', 'webp']}
          alt=""
          class="mv__fundo"
          style="object-position: center 25%"
          loading="lazy"
        />
        <div class="mv__corpo">
          <h2 class="mv__titulo">Missão</h2>
          <p>
            Proporcionar experiências de bem-estar e elevação da autoestima por meio de serviços de qualidade, em ambiente
            acolhedor que valoriza cada cliente e cada profissional.
          </p>
        </div>
      </article>
      <article class="mv__cartao" data-reveal>
        <Picture
          src={visao}
          width={900}
          height={600}
          widths={[480, 720, 900]}
          sizes="(min-width: 900px) 600px, 92vw"
          formats={['avif', 'webp']}
          alt=""
          class="mv__fundo"
          style="object-position: center 28%"
          loading="lazy"
        />
        <div class="mv__corpo">
          <h2 class="mv__titulo">Visão</h2>
          <p>
            Ser referência nacional no mercado de esmalterias, reconhecida pela excelência no atendimento, pela inovação
            nos serviços e pelo cuidado genuíno com quem nos escolhe.
          </p>
        </div>
      </article>
    </div>
  </section>

  <!-- Valores: pílulas que fluem no tamanho de cada nome -->
  <section class="section section--white valores-secao" aria-labelledby="valores-titulo">
    <Brilhos
      itens={[
        { x: '12%', y: '22%', t: 16, d: 0 },
        { x: '86%', y: '18%', t: 12, d: 1.4 },
        { x: '8%', y: '78%', t: 10, d: 2.2 },
        { x: '92%', y: '74%', t: 18, d: 0.8 },
      ]}
      cor="rosa"
    />
    <div class="container">
      <h2 class="section-title valores-secao__titulo" id="valores-titulo" data-reveal>Valores</h2>
      <ul class="valores" data-reveal-stagger="80">
        {
          VALORES.map(({ nome, Icone }) => (
            <li class="valor icon-host" data-reveal data-valor>
              <div class="valor__pilula">
                <span class="valor__icone">
                  <Icone size={24} draw />
                </span>
                <h3 class="valor__nome">{nome}</h3>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaFinal
    titulo={SITE.assinatura}
    origem="cta_final"
    imagem={clienteMaos}
    imagemAlt="Cliente sorrindo com a mão no rosto, unhas curtas em esmalte rosa-claro"
  />
</BaseLayout>

<script>
  // Valores: a pílula é "atraída" pelo mouse e o ícone acompanha um pouco mais (paralaxe)
  const mouseFino = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (mouseFino && !reduzir) {
    document.querySelectorAll<HTMLElement>('[data-valor]').forEach((valor) => {
      valor.addEventListener('pointermove', (e) => {
        const r = valor.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        valor.style.setProperty('--mx', x.toFixed(3));
        valor.style.setProperty('--my', y.toFixed(3));
      });
      valor.addEventListener('pointerleave', () => {
        valor.style.setProperty('--mx', '0');
        valor.style.setProperty('--my', '0');
      });
    });
  }
</script>

<style>
  /* ---------- História ---------- */
  .historia__grid {
    display: grid;
    gap: 36px;
    align-items: center;
  }

  .historia__media {
    overflow: hidden;
    border-radius: 24px;
  }

  .historia__media :global(.historia__img) {
    width: 100%;
    aspect-ratio: 4 / 4.5;
    object-fit: cover;
    object-position: 70% center;
  }

  .historia__texto .section-title {
    margin-bottom: 20px;
  }

  .historia__texto p {
    max-width: 58ch;
    margin-bottom: 16px;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  /* Celular: foto mais baixa, se dissolvendo no branco da metade para baixo, com o texto começando por cima */
  @media (max-width: 899px) {
    .historia__grid {
      gap: 0;
    }

    /* Cantos de baixo retos: a foto some no branco sem deixar contorno */
    .historia__media {
      position: relative;
      border-radius: 24px 24px 0 0;
    }

    .historia__media::after {
      content: '';
      position: absolute;
      inset: 0 0 -1px;
      background: linear-gradient(to bottom, rgba(255, 255, 255, 0) 42%, rgba(255, 255, 255, 0.85) 76%, #fff 92%);
      pointer-events: none;
    }

    .historia__media :global(.historia__img) {
      aspect-ratio: 4 / 3.4;
      object-position: 70% 30%;
    }

    .historia__texto {
      position: relative;
      margin-top: -60px;
    }
  }

  @media (min-width: 900px) {
    .historia__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 72px;
    }
  }

  /* ---------- Citação ---------- */
  .citacao {
    padding-block: 56px;
    background-color: var(--color-creme);
    border-block: 1px solid var(--color-line);
  }

  .citacao__texto {
    max-width: 880px;
    margin-inline: auto;
    text-align: center;
  }

  .citacao__brilhos {
    width: 48px;
    margin: 0 auto 20px;
    fill: var(--color-pink);
  }

  .citacao__texto p {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-purple);
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .citacao {
      padding-block: 80px;
    }
  }

  /* ---------- Missão e Visão ---------- */
  .mv {
    display: grid;
    gap: 16px;
  }

  /* Cartão em cor sólida; a foto entra como textura em tom único (luminosity), só de apoio */
  .mv__cartao {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: 340px;
    overflow: hidden;
    color: var(--color-white);
    background-color: var(--color-purple);
    border-radius: 24px;
  }

  .mv__cartao + .mv__cartao {
    background-color: var(--color-pink-dark);
  }

  .mv__cartao :global(.mv__fundo) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
    mix-blend-mode: luminosity;
    transition: transform 1.2s var(--ease-out-expo), opacity 600ms var(--ease);
  }

  .mv__corpo {
    padding: 28px 28px 32px;
  }

  .mv__titulo {
    margin-bottom: 10px;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1.05;
  }

  .mv__corpo p {
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
  }

  @media (hover: hover) and (pointer: fine) {
    .mv__cartao:hover :global(.mv__fundo) {
      opacity: 0.3;
      transform: scale(1.04);
    }
  }

  @media (min-width: 900px) {
    .mv {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .mv__cartao {
      min-height: 400px;
    }

    .mv__corpo {
      padding: 40px 44px 44px;
    }
  }

  /* ---------- Valores ---------- */
  .valores-secao {
    position: relative;
    isolation: isolate;
    padding-bottom: 16px;
  }

  .valores-secao :global(.brilhos) {
    z-index: -1;
  }

  .valores-secao__titulo {
    margin-bottom: 36px;
    text-align: center;
  }

  .valores {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 980px;
    margin-inline: auto;
    list-style: none;
  }

  /* O li cuida da entrada (reveal); a pílula flutua sozinha e é puxada pelo mouse (--mx/--my, de -0.5 a 0.5) */
  .valor {
    --mx: 0;
    --my: 0;
  }

  .valor__pilula {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 18px 6px 6px;
    background-color: var(--color-neutral-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    translate: calc(var(--mx) * 14px) calc(var(--my) * 10px);
    animation: valorFlutua 5.6s ease-in-out infinite;
    transition:
      translate 500ms var(--ease-out-expo),
      background-color 300ms var(--ease),
      border-color 300ms var(--ease),
      box-shadow 400ms var(--ease);
  }

  .valor:nth-child(2) .valor__pilula {
    animation-duration: 6.4s;
    animation-delay: -1.8s;
  }

  .valor:nth-child(3) .valor__pilula {
    animation-duration: 5.2s;
    animation-delay: -3.1s;
  }

  .valor:nth-child(4) .valor__pilula {
    animation-duration: 6.8s;
    animation-delay: -0.9s;
  }

  .valor:nth-child(5) .valor__pilula {
    animation-duration: 5.9s;
    animation-delay: -4.2s;
  }

  .valor:nth-child(6) .valor__pilula {
    animation-duration: 6.1s;
    animation-delay: -2.5s;
  }

  .valor:nth-child(3n + 2) .valor__pilula {
    background-color: var(--color-creme);
  }

  .valor:nth-child(3n) .valor__pilula {
    background-color: var(--color-blush);
  }

  @keyframes valorFlutua {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    30% {
      transform: translateY(-5px) rotate(-0.6deg);
    }
    70% {
      transform: translateY(3px) rotate(0.5deg);
    }
  }

  .valor__icone {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-white);
    background-color: var(--color-purple);
    border-radius: 50%;
    translate: calc(var(--mx) * 10px) calc(var(--my) * 8px);
    transition:
      translate 500ms var(--ease-out-expo),
      transform 500ms var(--ease-out-expo),
      background-color 300ms var(--ease);
  }

  .valor__nome {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-purple);
  }

  @media (hover: hover) and (pointer: fine) {
    .valor:hover .valor__pilula {
      background-color: var(--color-white);
      border-color: rgba(225, 82, 151, 0.45);
      box-shadow: 0 14px 32px -18px rgba(99, 32, 102, 0.45);
      animation-play-state: paused;
    }

    .valor:hover .valor__icone {
      background-color: var(--color-pink-dark);
      transform: rotate(-12deg) scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .valor__pilula {
      animation: none;
    }
  }

  @media (min-width: 768px) {
    .valores {
      gap: 14px;
    }

    .valor__pilula {
      gap: 16px;
      padding: 10px 30px 10px 10px;
    }

    .valor__icone {
      width: 56px;
      height: 56px;
    }

    .valor__nome {
      font-size: 1.4rem;
    }
  }
</style>
