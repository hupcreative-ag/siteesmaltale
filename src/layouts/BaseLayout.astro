---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/400-italic.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';

import { IS_PRODUCTION, SITE } from '../config/site';
import Tracking from '../components/seo/Tracking.astro';
import PreviewBanner from '../components/layout/PreviewBanner.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FloatingCta from '../components/layout/FloatingCta.astro';
import BookingModal from '../components/booking/BookingModal.astro';
import ContactStrip from '../components/sections/ContactStrip.astro';
import { grafo, organizacao, website } from '../lib/schema';
import gazpachoBold from '../assets/fontes/gazpacho-bold.woff2?url';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  /** Faixa "Dúvidas ou precisa de ajuda?" antes do rodapé (Sobre, Nail Design e Podologia). */
  contactStrip?: boolean;
  /** Imagem de compartilhamento: caminho em public/ (já 1200x630) ou foto de src/assets,
      recortada aqui para 1200x630. */
  ogImage?: string | ImageMetadata;
  /** Descrição da imagem de compartilhamento. */
  ogImageAlt?: string;
  /** Nós extras de JSON-LD da página; somam-se à organização e ao site, num só @graph. */
  schema?: object[];
  /** Tira a página dos buscadores mesmo em produção (ex.: 404). */
  noindex?: boolean;
}

const {
  title,
  description,
  contactStrip = false,
  ogImage = '/og-image.jpg',
  ogImageAlt = `${SITE.nome}: ${SITE.assinatura}`,
  schema = [],
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImagePath =
  typeof ogImage === 'string'
    ? ogImage
    : (await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 })).src;
const ogImageUrl = new URL(ogImagePath, SITE.url).href;
const logo = { url: new URL('/logo-esmaltale.png', SITE.url).href, width: 1012, height: 278 };
const jsonLd = grafo(organizacao(logo), website(), ...schema);

// Página aberta por transição: o título entra parado (a troca já esmaece) e os blocos da
// primeira tela só aparecem, sem subir; senão o texto parece "pular". Transição pulada (aba em
// segundo plano etc.) rejeita as promessas: tratadas para não sujar o console.
---

<!doctype html>
<html lang="pt-BR" class:list={{ 'is-preview': !IS_PRODUCTION }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={IS_PRODUCTION && !noindex ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' : 'noindex, nofollow'} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline>
      addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        var html = document.documentElement;
        html.classList.add('vt-entrada', 'vt-ativa');
        var fim = function () {
          html.classList.remove('vt-ativa');
        };
        var vt = e.viewTransition;
        vt.ready.catch(fim);
        vt.updateCallbackDone && vt.updateCallbackDone.catch(function () {});
        vt.finished.then(fim, fim);
      });
      addEventListener('pageswap', function (e) {
        var vt = e.viewTransition;
        if (!vt) return;
        var nada = function () {};
        vt.ready.catch(nada);
        vt.updateCallbackDone && vt.updateCallbackDone.catch(nada);
        vt.finished.catch(nada);
      });
    </script>
    <Tracking />
    <meta name="theme-color" content="#6B1F7C" />
    <meta name="author" content={SITE.nome} />
    <meta name="format-detection" content="telephone=no" />
    <!-- O Google usa ícones em múltiplos de 48px (48, 96, 192); o .ico cobre navegadores antigos. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={gazpachoBold} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Resumo do site para IAs (llms.txt)" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="geo.region" content="BR-BA" />
    <meta name="geo.placename" content="Salvador" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <PreviewBanner />
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    {contactStrip && <ContactStrip />}
    <Footer />
    <FloatingCta />
    <BookingModal />

    <script>
      import { initIconDraw } from '../scripts/icons-draw';
      import { initClickTracking } from '../scripts/analytics';
      import { initReveal } from '../scripts/reveal';
      initReveal();
      initIconDraw();
      initClickTracking();
    </script>
  </body>
</html>
