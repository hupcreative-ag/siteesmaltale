---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/400-italic.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';

import { IS_PRODUCTION, SITE } from '../config/site';
import Tracking from '../components/seo/Tracking.astro';
import PreviewBanner from '../components/layout/PreviewBanner.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FloatingCta from '../components/layout/FloatingCta.astro';
import BookingModal from '../components/booking/BookingModal.astro';
import ContactStrip from '../components/sections/ContactStrip.astro';
import { grafo, organizacao, website } from '../lib/schema';
import gazpachoBold from '../assets/fontes/gazpacho-bold.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Faixa "Dúvidas ou precisa de ajuda?" antes do rodapé (Sobre, Nail Art e Podologia). */
  contactStrip?: boolean;
  /** Imagem de compartilhamento (1200x630, em public/). */
  ogImage?: string;
  /** Nós extras de JSON-LD da página; somam-se à organização e ao site, num só @graph. */
  schema?: object[];
  /** Tira a página dos buscadores mesmo em produção (ex.: 404). */
  noindex?: boolean;
}

const { title, description, contactStrip = false, ogImage = '/og-image.jpg', schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const jsonLd = grafo(organizacao(new URL('/logo-esmaltale.png', SITE.url).href), website(), ...schema);
---

<!doctype html>
<html lang="pt-BR" class:list={{ 'is-preview': !IS_PRODUCTION }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Página aberta por transição: o título entra parado (a troca já esmaece) e os blocos
         da primeira tela só aparecem, sem subir; senão o texto parece "pular". -->
    <script is:inline>
      addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        var html = document.documentElement;
        html.classList.add('vt-entrada', 'vt-ativa');
        var fim = function () {
          html.classList.remove('vt-ativa');
        };
        // Transição pulada (aba em segundo plano etc.) rejeita o ready: tratado para não sujar o console
        var vt = e.viewTransition;
        vt.ready.catch(fim);
        vt.updateCallbackDone && vt.updateCallbackDone.catch(function () {});
        vt.finished.then(fim, fim);
      });
      // Lado da página que sai: mesma rejeição quando a transição é pulada
      addEventListener('pageswap', function (e) {
        var vt = e.viewTransition;
        if (!vt) return;
        var nada = function () {};
        vt.ready.catch(nada);
        vt.updateCallbackDone && vt.updateCallbackDone.catch(nada);
        vt.finished.catch(nada);
      });
    </script>
    <Tracking />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={IS_PRODUCTION && !noindex ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#6B1F7C" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={gazpachoBold} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.nome}: ${SITE.assinatura}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="geo.region" content="BR-BA" />
    <meta name="geo.placename" content="Salvador" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <PreviewBanner />
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    {contactStrip && <ContactStrip />}
    <Footer />
    <FloatingCta />
    <BookingModal />

    <script>
      import { initIconDraw } from '../scripts/icons-draw';
      import { initClickTracking } from '../scripts/analytics';
      import { initReveal } from '../scripts/reveal';
      initReveal();
      initIconDraw();
      initClickTracking();
    </script>
  </body>
</html>
