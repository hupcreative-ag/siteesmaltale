---
/** "Nossas unidades" na Home (id="unidades", destino do link "Ver unidades" do hero). */
import { unidadesAtivas, listaCidades } from '../../lib/unidades';
import UnitCard from '../unidades/UnitCard.astro';
---

<section class="section section--neutral" id="unidades" aria-labelledby="unidades-titulo">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{listaCidades}</span>
      <h2 class="section-title" id="unidades-titulo">Nossas unidades</h2>
      <p class="section-description">Estamos nos principais shoppings de Salvador. Escolha a mais perto de você.</p>
    </div>

    <ul class="unidades__grid">
      {
        unidadesAtivas.map((u) => (
          <li>
            <UnitCard unidade={u} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .unidades__grid {
    display: grid;
    gap: 24px;
    list-style: none;
  }

  @media (min-width: 640px) {
    .unidades__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .unidades__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
