---
/**
 * "Nossas unidades" na Home (id="unidades", destino do botão "Agende agora" do hero).
 * Celular e tablet: 2 colunas (no celular, cards compactos). Desktop: 3.
 */
import { unidadesAtivas } from '../../lib/unidades';
import UnitCard from '../unidades/UnitCard.astro';
import Brilhos from '../sections/Brilhos.astro';
---

<section class="section section--neutral unidades" id="unidades" aria-labelledby="unidades-titulo">
  <Brilhos
    itens={[
      { x: '4%', y: '9%', t: 18, d: 0 },
      { x: '46%', y: '5%', t: 10, d: 1.6 },
      { x: '96%', y: '12%', t: 14, d: 0.8 },
      { x: '2%', y: '56%', t: 10, d: 2.4 },
      { x: '98%', y: '62%', t: 20, d: 1.2 },
      { x: '50%', y: '97%', t: 12, d: 3 },
    ]}
  />
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 class="section-title" id="unidades-titulo">Nossas unidades</h2>
      <p class="section-description">Estamos nos principais shoppings de Salvador. Escolha a mais perto de você.</p>
    </div>

    <ul class="unidades__lista" data-reveal-stagger="90">
      {
        unidadesAtivas.map((u) => (
          <li class="unidades__item" data-reveal>
            <UnitCard unidade={u} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .unidades {
    position: relative;
    isolation: isolate;
  }

  .unidades :global(.brilhos) {
    z-index: -1;
  }

  .unidades__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
  }

  .unidades__item {
    position: relative;
  }

  @media (min-width: 640px) {
    .unidades__lista {
      gap: 24px;
    }
  }

  @media (min-width: 1024px) {
    .unidades__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
