---
/**
 * "Nossos serviços": os 10 serviços na ordem do documento (sem o SPA das Mãos, retirado a pedido). Desktop e tablet: carrossel horizontal
 * de cards (arrastável). Celular: lista empilhada; cada item é uma faixa com foto, nome e "+",
 * e expande ao tocar.
 * Card: foto com película escura no topo, nome e um "+" no canto. Hover (mouse) ou toque no "+"
 * abre um painel de vidro com a descrição e os botões "Agendar agora" e "Saiba mais".
 * O carrossel é rolagem nativa com scroll-snap; as setas só deslocam a rolagem.
 */
import { Picture } from 'astro:assets';
import { SERVICOS } from '../../data/servicos';
import icone from '../../assets/marca/icone.svg';
import IconArrow from '../icons/IconArrow.astro';
---

<section class="section section--white servicos" aria-labelledby="servicos-titulo">
  <div class="container servicos__topo" data-reveal>
    <div class="servicos__texto">
      <h2 class="section-title" id="servicos-titulo">Nossos serviços</h2>
      <p class="section-description">Cuidado completo para as suas mãos e pés, com técnica, higiene e muito carinho.</p>
    </div>
    <div class="servicos__setas">
      <button type="button" class="servicos__seta servicos__seta--anterior" aria-label="Serviços anteriores" data-servicos-seta="-1">
        <IconArrow size={20} />
      </button>
      <button type="button" class="servicos__seta" aria-label="Próximos serviços" data-servicos-seta="1">
        <IconArrow size={20} />
      </button>
    </div>
  </div>

  <ul class="servicos__trilho" data-servicos-trilho data-reveal-stagger="70">
    {
      SERVICOS.map((s) => (
        <li class="servicos__item" data-reveal>
          <article class="servico">
            {s.imagem ? (
              <Picture
                src={s.imagem}
                width={720}
                height={900}
                widths={[360, 540, 720]}
                sizes="(min-width: 1200px) 260px, (min-width: 768px) 30vw, 92vw"
                formats={['avif', 'webp']}
                alt={`${s.nome} na Esmaltale`}
                class="servico__img"
                style={s.foco ? `object-position: ${s.foco}` : undefined}
                loading="lazy"
                draggable="false"
              />
            ) : (
              <div class="servico__fallback brand-gradient">
                <img src={icone.src} width="56" height="56" alt="" draggable="false" />
              </div>
            )}
            <div class="servico__pelicula" />
            <h3 class="servico__nome">{s.nome}</h3>

            <button
              type="button"
              class="servico__mais"
              aria-expanded="false"
              aria-controls={`servico-${s.slug}`}
              aria-label={`Saiba mais sobre ${s.nome}`}
              data-servico-abrir
            >
              <span aria-hidden="true" />
            </button>

            <div class="servico__painel" id={`servico-${s.slug}`}>
              <p class="servico__texto">{s.descricao}</p>
              <div class="servico__acoes">
                <button type="button" class="servico__agendar" data-booking data-booking-origem="card_servico">
                  <span>Agendar agora<span class="sr-only">: {s.nome}</span></span>
                  <span class="servico__agendar-seta" aria-hidden="true">
                    <IconArrow size={16} />
                  </span>
                </button>
                {s.saibaMais && (
                  <a href={s.saibaMais} class="servico__saiba">
                    Saiba mais sobre o serviço<span class="sr-only">: {s.nome}</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const celular = window.matchMedia('(max-width: 767px)');
  const ALTURA_FECHADA = 96;
  const ALTURA_ABERTA = 420;

  /** Celular: rola para o cartão aberto ficar no centro da tela, já descontando
      o cartão que está fechando acima dele (que encolhe durante a animação). */
  function centralizar(card: HTMLElement, anterior: HTMLElement | null) {
    let topo = card.getBoundingClientRect().top + window.scrollY;
    if (anterior && anterior.compareDocumentPosition(card) & Node.DOCUMENT_POSITION_FOLLOWING) {
      topo -= anterior.getBoundingClientRect().height - ALTURA_FECHADA;
    }
    window.scrollTo({ top: topo - (window.innerHeight - ALTURA_ABERTA) / 2, behavior: 'smooth' });
  }

  // "+": abre e fecha o painel (no celular é o único jeito; com mouse no desktop, o hover também abre)
  document.querySelectorAll<HTMLButtonElement>('[data-servico-abrir]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest<HTMLElement>('.servico');
      if (!card) return;
      const aberto = !card.classList.contains('is-open');
      const anterior = document.querySelector<HTMLElement>('.servico.is-open');
      if (aberto && celular.matches) centralizar(card, anterior !== card ? anterior : null);
      document.querySelectorAll('.servico.is-open').forEach((c) => {
        c.classList.remove('is-open');
        c.querySelector('[data-servico-abrir]')?.setAttribute('aria-expanded', 'false');
      });
      card.classList.toggle('is-open', aberto);
      btn.setAttribute('aria-expanded', String(aberto));
    });
  });

  // Arrastar com o mouse (no toque a rolagem já é nativa). Um arraste não conta como clique.
  const pista = document.querySelector<HTMLElement>('[data-servicos-trilho]');
  if (pista) {
    let inicioX = 0;
    let inicioScroll = 0;
    let pressionado = false;
    let arrastou = false;
    pista.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0 || celular.matches) return;
      pressionado = true;
      arrastou = false;
      inicioX = e.clientX;
      inicioScroll = pista.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!pressionado) return;
      const dx = e.clientX - inicioX;
      if (!arrastou && Math.abs(dx) > 6) {
        arrastou = true;
        pista.classList.add('is-dragging');
      }
      if (arrastou) pista.scrollLeft = inicioScroll - dx;
    });
    window.addEventListener('pointerup', () => {
      if (!pressionado) return;
      pressionado = false;
      pista.classList.remove('is-dragging');
    });
    pista.addEventListener(
      'click',
      (e) => {
        if (!arrastou) return;
        e.preventDefault();
        e.stopPropagation();
        arrastou = false;
      },
      true,
    );
  }

  // Setas: deslocam a rolagem em um card e se desativam nas pontas
  const trilho = document.querySelector<HTMLElement>('[data-servicos-trilho]');
  const setas = document.querySelectorAll<HTMLButtonElement>('[data-servicos-seta]');
  if (trilho) {
    const atualizar = () => {
      const fim = trilho.scrollWidth - trilho.clientWidth - 4;
      setas.forEach((s) => {
        s.disabled = Number(s.dataset.servicosSeta) < 0 ? trilho.scrollLeft <= 4 : trilho.scrollLeft >= fim;
      });
    };
    setas.forEach((s) =>
      s.addEventListener('click', () => {
        const item = trilho.querySelector<HTMLElement>('.servicos__item');
        const passo = item ? item.offsetWidth + 16 : trilho.clientWidth * 0.8;
        trilho.scrollBy({ left: passo * Number(s.dataset.servicosSeta), behavior: 'smooth' });
      }),
    );
    trilho.addEventListener('scroll', atualizar, { passive: true });
    window.addEventListener('resize', atualizar);
    atualizar();
  }
</script>

<style>
  .servicos {
    overflow: hidden;
  }

  .servicos__topo {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
  }

  .servicos__texto {
    max-width: 640px;
  }

  .servicos__texto .section-title {
    margin-bottom: 12px;
  }

  .servicos__setas {
    display: none;
    gap: 8px;
  }

  .servicos__seta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--color-purple);
    border: 1px solid var(--color-line);
    border-radius: 50%;
    transition: background-color 250ms var(--ease), color 250ms var(--ease), border-color 250ms var(--ease), opacity 250ms var(--ease);
  }

  .servicos__seta:hover:not(:disabled) {
    color: var(--color-white);
    background-color: var(--color-purple);
    border-color: var(--color-purple);
  }

  .servicos__seta:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .servicos__seta--anterior :global(.icon) {
    transform: rotate(180deg);
  }

  /* Trilho: só rolagem horizontal, alinhado ao container e sangrando até a borda direita */
  .servicos__trilho {
    --inicio: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    display: flex;
    gap: 14px;
    padding: 0 var(--inicio);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--inicio);
    list-style: none;
    scrollbar-width: none;
  }

  .servicos__trilho::-webkit-scrollbar {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 768px) {
    .servicos__trilho {
      cursor: grab;
    }
  }

  .servicos__trilho.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .servicos__trilho.is-dragging .servico {
    pointer-events: none;
  }

  .servicos__item {
    position: relative;
    flex: 0 0 64%;
    max-width: 280px;
    scroll-snap-align: start;
  }

  .servico {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    isolation: isolate;
    color: var(--color-white);
    background-color: var(--color-blush);
    border-radius: 20px;
  }

  .servico :global(.servico__img),
  .servico__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
    transition: transform 900ms var(--ease-out-expo);
  }

  .servico__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .servico__pelicula {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(54, 33, 58, 0.58) 0%, rgba(54, 33, 58, 0) 42%),
      linear-gradient(0deg, rgba(54, 33, 58, 0.22) 0%, rgba(54, 33, 58, 0) 30%);
    transition: background-color 500ms var(--ease-out-expo);
  }

  .servico__fallback + .servico__pelicula {
    background: linear-gradient(180deg, rgba(99, 32, 102, 0.55) 0%, rgba(99, 32, 102, 0) 42%);
  }

  .servico__nome {
    position: absolute;
    top: 18px;
    left: 20px;
    right: 64px;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.08;
  }

  /* "+" que gira até virar "×" */
  .servico__mais {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    width: 40px;
    height: 40px;
    background-color: var(--color-white);
    border-radius: 50%;
    transition: transform 500ms var(--ease-out-expo);
  }

  .servico__mais span::before,
  .servico__mais span::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 13px;
    height: 1.75px;
    background-color: var(--color-purple);
    border-radius: 2px;
    transform: translate(-50%, -50%);
  }

  .servico__mais span::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  /* Painel de vidro */
  .servico__painel {
    position: absolute;
    inset: auto 10px 10px;
    z-index: 2;
    padding: 16px;
    background-color: rgba(54, 33, 58, 0.36);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 14px;
    backdrop-filter: blur(22px) saturate(140%);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition:
      opacity 400ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s linear 500ms;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .servico__painel {
      background-color: rgba(54, 33, 58, 0.78);
    }
  }

  .servico__texto {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-white);
  }

  .servico__acoes {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    margin-top: 14px;
  }

  /* Pílula branca com círculo roxo e seta à direita */
  .servico__agendar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 46px;
    padding: 0 5px 0 18px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-purple);
    background-color: var(--color-white);
    border-radius: var(--radius-pill);
  }

  .servico__agendar-seta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-white);
    background-color: var(--color-purple);
    border-radius: 50%;
    transition: transform 500ms var(--ease-out-expo), background-color 250ms var(--ease);
  }

  .servico__agendar:hover .servico__agendar-seta {
    background-color: var(--color-pink);
    transform: rotate(-45deg);
  }

  .servico__saiba {
    align-self: center;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.45);
    text-underline-offset: 4px;
    transition: text-decoration-color 250ms var(--ease);
  }

  .servico__saiba:hover {
    text-decoration-color: var(--color-white);
  }

  /* Estado aberto: clique no "+" ou hover com mouse */
  .servico.is-open .servico__painel {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 400ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s;
  }

  .servico.is-open .servico__mais {
    transform: rotate(135deg);
  }

  .servico.is-open :global(.servico__img),
  .servico.is-open .servico__fallback {
    transform: scale(1.06);
  }

  /* Hover só no desktop/tablet com mouse; no celular o painel abre apenas pelo "+" */
  @media (hover: hover) and (pointer: fine) and (min-width: 768px) {
    .servico:hover .servico__painel {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 400ms cubic-bezier(0.2, 0.8, 0.2, 1),
        transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1),
        visibility 0s;
    }

    .servico:hover .servico__mais {
      transform: rotate(135deg);
    }

    .servico:hover :global(.servico__img),
    .servico:hover .servico__fallback {
      transform: scale(1.06);
    }
  }

  /* ---------- Celular: lista empilhada que expande ---------- */
  @media (max-width: 767px) {
    .servicos__trilho {
      flex-direction: column;
      gap: 10px;
      padding: 0 var(--gutter);
      overflow: visible;
      scroll-snap-type: none;
    }

    .servicos__item {
      flex: none;
      max-width: none;
    }

    .servico {
      aspect-ratio: auto;
      height: 96px;
      border-radius: 16px;
      transition: height 550ms var(--ease-out-expo);
    }

    .servico.is-open {
      height: 420px;
    }

    .servico__pelicula {
      background: linear-gradient(90deg, rgba(54, 33, 58, 0.7) 0%, rgba(54, 33, 58, 0.25) 70%, rgba(54, 33, 58, 0.1) 100%);
    }

    .servico.is-open .servico__pelicula {
      background:
        linear-gradient(180deg, rgba(54, 33, 58, 0.58) 0%, rgba(54, 33, 58, 0) 42%),
        linear-gradient(0deg, rgba(54, 33, 58, 0.22) 0%, rgba(54, 33, 58, 0) 30%);
    }

    .servico__nome {
      top: 50%;
      left: 18px;
      right: 72px;
      font-size: 1.3rem;
      transform: translateY(-50%);
      transition: top 550ms var(--ease-out-expo), transform 550ms var(--ease-out-expo);
    }

    .servico.is-open .servico__nome {
      top: 20px;
      transform: none;
    }

    .servico__mais {
      top: 28px;
      right: 16px;
      transition: top 550ms var(--ease-out-expo), transform 500ms var(--ease-out-expo);
    }

    .servico.is-open .servico__mais {
      top: 14px;
    }

    .servico__fallback img {
      width: 40px;
      height: 40px;
      margin-left: 40%;
      opacity: 0.7;
    }
  }

  @media (min-width: 768px) {
    .servicos__setas {
      display: flex;
    }

    .servicos__topo {
      margin-bottom: 44px;
    }

    .servicos__item {
      flex-basis: 30%;
    }
  }

  @media (min-width: 1200px) {
    .servicos__item {
      flex-basis: 260px;
    }
  }
</style>
