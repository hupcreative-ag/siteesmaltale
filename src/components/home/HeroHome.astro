---
/**
 * Hero da Home dentro de um quadro de cantos arredondados (16px de margem da tela no desktop,
 * 8px no celular). O header fixo fica por cima do quadro.
 * O primeiro slide é o hero institucional (único com h1). Os banners ativos de src/data/hero.ts
 * entram depois; sem nenhum, não há carrossel. O slide 1 tem a foto da loja sob o degradê da marca
 * em movimento, com o texto centralizado. Os banners usam a foto nas cores reais, com desfoque
 * progressivo e degradê claro só na área do texto (à esquerda; na base no celular).
 * Comportamento do carrossel em src/scripts/carousel.ts.
 */
import { Picture } from 'astro:assets';
import heroFoto from '../../assets/lojas/shopping-barra-interna.jpg';
import { bannersAtivos } from '../../data/hero';
import { totalUnidades, porExtenso } from '../../lib/unidades';
import IconArrow from '../icons/IconArrow.astro';

const titulo = 'A sua pausa favorita de beleza e bem-estar';
const palavras = titulo.split(' ');
let indiceLetra = 0;

const ALT_BANNER: Record<string, string> = {
  podologia: 'Podóloga tratando os pés de uma cliente na Esmaltale',
  experiencia: 'Cliente escolhendo um esmalte na prateleira da Esmaltale',
};

const totalSlides = 1 + bannersAtivos.length;
const comCarrossel = totalSlides > 1;
---

<section
  class="hero"
  data-hero
  aria-label="Destaques"
  aria-roledescription={comCarrossel ? 'carrossel' : undefined}
  data-carousel={comCarrossel ? '' : undefined}
>
  <div class="hero__frame">
    <div class="hero__track" aria-live="polite" data-carousel-track>
      <div
        class="hero__slide hero__slide--centro is-active"
        role={comCarrossel ? 'group' : undefined}
        aria-roledescription={comCarrossel ? 'slide' : undefined}
        aria-label={comCarrossel ? `1 de ${totalSlides}` : undefined}
        data-slide
      >
        <Picture
          src={heroFoto}
          widths={[768, 1280, 1920, 2000]}
          sizes="(max-width: 767px) 300vw, 100vw"
          formats={['avif', 'webp']}
          alt="Interior da Esmaltale no Shopping Barra, com poltronas de atendimento, bancadas e prateleiras de esmaltes"
          class="hero__photo hero__photo--loja"
          loading="eager"
          fetchpriority="high"
        />
        <div class="gradiente-marca hero__degrade" aria-hidden="true"></div>
        <div class="container hero__content hero__content--centro">
          <svg class="hero__brilhos" viewBox="0 0 64 24" aria-hidden="true" focusable="false">
            <path d="M12 4c.6 3.6 1.9 5 5.4 5.6-3.5.6-4.8 2-5.4 5.6-.6-3.6-1.9-5-5.4-5.6 3.5-.6 4.8-2 5.4-5.6z" />
            <path d="M32 0c.9 5.4 2.9 7.5 8.1 8.4-5.2.9-7.2 3-8.1 8.4-.9-5.4-2.9-7.5-8.1-8.4 5.2-.9 7.2-3 8.1-8.4z" />
            <path d="M52 4c.6 3.6 1.9 5 5.4 5.6-3.5.6-4.8 2-5.4 5.6-.6-3.6-1.9-5-5.4-5.6 3.5-.6 4.8-2 5.4-5.6z" />
          </svg>
          <h1 class="hero__title">
            <span class="sr-only">{titulo}</span>
            <span class="split" aria-hidden="true">
              {
                palavras.map((palavra, i) => (
                  <Fragment>
                    {i > 0 && ' '}
                    <span class="split-word">
                      {[...palavra].map((letra) => (
                        <span class="split-char" style={`--i:${indiceLetra++}`}>
                          {letra}
                        </span>
                      ))}
                    </span>
                  </Fragment>
                ))
              }
            </span>
          </h1>
          <p class="hero__subtitle">{porExtenso(totalUnidades, true)} unidades nos principais shoppings da Bahia.</p>
          <div class="hero__actions">
            <!-- Leva até as unidades, onde cada loja tem Trinks e WhatsApp (pedido do usuário) -->
            <a href="#unidades" class="specular-button specular-button--dark hero__cta">Agende agora</a>
          </div>
        </div>
      </div>

      {
        bannersAtivos.map((banner, i) => (
          <div
            class="hero__slide hero__slide--foto hero__slide--banner"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 2} de ${totalSlides}`}
            data-slide
          >
            <Picture
              src={banner.imagem}
              widths={[768, 1280, 1600]}
              sizes="100vw"
              formats={['avif', 'webp']}
              alt={ALT_BANNER[banner.id] ?? ''}
              class="hero__photo"
              style={banner.posicao ? `object-position: ${banner.posicao}` : undefined}
              loading="eager"
              fetchpriority="low"
            />
            <div class="hero__veu" />
            <div class="hero__overlay" />
            <div class="container hero__content hero__content--banner">
              <h2 class="hero__title hero__title--banner">{banner.titulo}</h2>
              <p class="hero__subtitle">{banner.subtitulo}</p>
              <div class="hero__actions">
                <a href={banner.cta.href} class="hero__textlink">
                  {banner.cta.label}
                  <IconArrow size={18} />
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    {
      comCarrossel && (
        <div class="hero__controls">
          <button type="button" class="hero__pause" aria-label="Pausar destaques" data-carousel-pause>
            <svg class="hero__pause-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
              <path d="M9 6v12M15 6v12" />
            </svg>
            <svg class="hero__play-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
              <path d="M8 5.5v13l10-6.5z" />
            </svg>
          </button>
          <div class="hero__dots">
            {Array.from({ length: totalSlides }, (_, n) => (
              <button
                type="button"
                class="hero__dot"
                aria-label={`Mostrar destaque ${n + 1} de ${totalSlides}`}
                aria-current={n === 0 ? 'true' : 'false'}
                data-carousel-dot={n}
              />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  import { initHeroCarousel } from '../../scripts/carousel';
  initHeroCarousel();
</script>

<style>
  /* Moldura: ocupa a tela inteira menos --frame-inset em cada borda, em qualquer janela */
  .hero {
    padding: calc(var(--preview-h) + var(--frame-inset)) var(--frame-inset) 0;
    background-color: var(--color-white);
    color: var(--color-purple);
  }

  .hero__frame {
    position: relative;
    display: grid;
    min-height: max(560px, calc(100svh - var(--preview-h) - 2 * var(--frame-inset)));
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-blush);
    border-radius: 18px;
  }

  .hero__track {
    display: grid;
    touch-action: pan-y;
  }

  /* Slides empilhados na mesma célula, esticados até a altura da moldura */
  .hero__slide {
    position: relative;
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-h) + 24px);
    padding-bottom: 96px;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: opacity 900ms var(--ease), visibility 0s linear 900ms;
  }

  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 900ms var(--ease), visibility 0s;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__brilhos {
    width: 54px;
    height: auto;
    margin-bottom: 20px;
    fill: var(--color-purple);
    opacity: 0.85;
  }

  .hero__title {
    max-width: 12ch;
    margin-bottom: 20px;
    font-size: clamp(2.4rem, min(4.8vw, 8.6vh), 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--color-purple);
    text-wrap: balance;
  }

  .split-word {
    display: inline-block;
    white-space: nowrap;
  }

  .split-char {
    display: inline-block;
    animation: charIn 1.2s cubic-bezier(0.215, 0.61, 0.355, 1) both;
    animation-delay: calc(0.2s + var(--i) * 28ms);
  }

  @keyframes charIn {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__subtitle {
    max-width: 44ch;
    margin-bottom: clamp(28px, 4.5vh, 44px);
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
    line-height: 1.55;
    color: #5B3D60;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 28px;
  }

  /* ---------- Slide 1: foto da loja sob o degradê da marca, texto no centro ---------- */
  .hero__slide--centro {
    justify-content: center;
    text-align: center;
  }

  .hero__degrade {
    z-index: 1;
    opacity: 0.84;
  }

  .hero__content--centro {
    width: 100%;
  }

  /* ---------- Banners com foto em tela cheia e véu claro da marca ---------- */
  .hero__slide--foto {
    align-items: flex-end;
  }

  .hero__slide :global(.hero__photo.hero__photo--loja) {
    object-position: 45% center;
  }

  .hero__slide :global(.hero__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Véu: desfoque progressivo na área do texto + degradê claro mais leve por cima.
     Celular: de baixo para cima (texto na base). Desktop: da esquerda para a direita. */
  .hero__veu,
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero__veu {
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    mask-image: linear-gradient(0deg, #000 0%, #000 34%, transparent 62%);
    -webkit-mask-image: linear-gradient(0deg, #000 0%, #000 34%, transparent 62%);
  }

  .hero__overlay {
    background:
      linear-gradient(180deg, rgba(249, 239, 242, 0.55) 0%, rgba(249, 239, 242, 0) 18%),
      linear-gradient(0deg, rgba(249, 239, 242, 0.86) 0%, rgba(249, 239, 242, 0.66) 40%, rgba(249, 239, 242, 0) 66%);
  }

  /* Link do banner: texto com linha rosa e seta */
  .hero__textlink {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0 10px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-purple);
  }

  .hero__textlink::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--color-pink);
    border-radius: 2px;
    transform-origin: left;
    transition: transform 500ms var(--ease-out-expo);
  }

  .hero__textlink:hover::after {
    transform: scaleX(1.12);
  }

  .hero__textlink :global(.icon) {
    transition: transform 400ms var(--ease-out-expo);
  }

  .hero__textlink:hover :global(.icon) {
    transform: translateX(5px);
  }

  /* Celular: botões do hero compactos */
  @media (max-width: 767px) {
    .hero__cta {
      padding: 13px 24px;
      font-size: 0.8125rem;
      border-radius: var(--radius-pill);
    }
  }

  .hero__content--banner {
    align-items: flex-start;
    text-align: left;
  }

  .hero__title--banner {
    max-width: 17ch;
    font-size: clamp(2rem, min(3.9vw, 7vh), 3.6rem);
    margin-bottom: 16px;
  }

  .hero__content--banner .hero__subtitle {
    margin-bottom: clamp(24px, 4vh, 36px);
  }

  .hero__content--banner .hero__actions {
    justify-content: flex-start;
  }

  .hero__slide--banner.is-active .hero__content > * {
    animation: bannerIn 1s var(--ease-out-expo) both;
  }

  .hero__slide--banner.is-active .hero__content > :nth-child(2) { animation-delay: 120ms; }
  .hero__slide--banner.is-active .hero__content > :nth-child(3) { animation-delay: 240ms; }

  @keyframes bannerIn {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Controles em vidro claro, na base da moldura ---------- */
  .hero__controls {
    position: absolute;
    left: 50%;
    bottom: clamp(16px, 3vh, 28px);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    transform: translateX(-50%);
  }

  html:not(.js) .hero__controls {
    display: none;
  }

  .hero__pause,
  .hero__dots {
    background-color: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(99, 32, 102, 0.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .hero__pause {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-purple);
    border-radius: 50%;
    transition: background-color 250ms var(--ease);
  }

  .hero__pause:hover {
    background-color: rgba(255, 255, 255, 0.8);
  }

  .hero__pause svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero__play-icon,
  .hero__pause.is-paused .hero__pause-icon {
    display: none;
  }

  .hero__pause.is-paused .hero__play-icon {
    display: block;
  }

  .hero__dots {
    display: flex;
    align-items: center;
    height: 40px;
    padding-inline: 6px;
    border-radius: var(--radius-pill);
  }

  /* Área de toque de 28px com o ponto desenhado no ::before */
  .hero__dot {
    position: relative;
    width: 28px;
    height: 28px;
  }

  .hero__dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    background-color: rgba(99, 32, 102, 0.3);
    border-radius: var(--radius-pill);
    transform: translate(-50%, -50%);
    transition: width 400ms var(--ease-out-expo), background-color 250ms var(--ease);
  }

  .hero__dot:hover::before {
    background-color: rgba(99, 32, 102, 0.55);
  }

  .hero__dot[aria-current='true']::before {
    width: 22px;
    background-color: var(--color-purple);
  }

  @media (min-width: 768px) {
    .hero__frame {
      border-radius: 30px;
    }

    .hero__slide {
      padding-bottom: 104px;
    }

    .hero__slide--foto {
      align-items: center;
    }

    /* Desktop: véu da esquerda para a direita, texto à esquerda */
    .hero__veu {
      mask-image: linear-gradient(90deg, #000 0%, #000 32%, transparent 56%);
      -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 32%, transparent 56%);
    }

    .hero__overlay {
      background:
        linear-gradient(180deg, rgba(249, 239, 242, 0.45) 0%, rgba(249, 239, 242, 0) 18%),
        linear-gradient(90deg, rgba(249, 239, 242, 0.78) 0%, rgba(249, 239, 242, 0.6) 32%, rgba(249, 239, 242, 0.18) 50%, rgba(249, 239, 242, 0) 62%);
    }

    .hero__content--banner > * {
      max-width: min(560px, 44vw);
    }

    .hero__content--centro .hero__title {
      max-width: 18ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .split-char,
    .hero__slide--banner.is-active .hero__content > * {
      animation: none;
    }
  }
</style>
