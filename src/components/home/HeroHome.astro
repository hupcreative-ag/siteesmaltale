---
/**
 * Hero da Home. O primeiro slide é o hero institucional (único com h1). Os banners ativos
 * de src/data/hero.ts entram depois; sem nenhum, não há carrossel nem controles.
 * Comportamento do carrossel em src/scripts/carousel.ts.
 */
import { Picture } from 'astro:assets';
import heroFoto from '../../assets/lojas/salvador-shopping-02.jpg';
import { bannersAtivos } from '../../data/hero';
import { totalUnidades, porExtenso, listaCidades } from '../../lib/unidades';
import IconPin from '../icons/IconPin.astro';
import IconArrow from '../icons/IconArrow.astro';

const titulo = 'O cuidado que você merece, sempre que precisar.';
const palavras = titulo.split(' ');
let indiceLetra = 0;

const ALT_BANNER: Record<string, string> = {
  podologia: 'Podóloga atendendo uma cliente na Esmaltale',
  experiencia: 'Cliente escolhendo um esmalte na prateleira da Esmaltale',
};

const totalSlides = 1 + bannersAtivos.length;
const comCarrossel = totalSlides > 1;
---

<section
  class="hero"
  aria-label="Destaques"
  aria-roledescription={comCarrossel ? 'carrossel' : undefined}
  data-carousel={comCarrossel ? '' : undefined}
>
  <div class="hero__track" aria-live="polite" data-carousel-track>
    <div
      class="hero__slide hero__slide--institucional brand-gradient is-active"
      role={comCarrossel ? 'group' : undefined}
      aria-roledescription={comCarrossel ? 'slide' : undefined}
      aria-label={comCarrossel ? `1 de ${totalSlides}` : undefined}
      data-slide
    >
      <Picture
        src={heroFoto}
        widths={[768, 1280, 1920]}
        sizes="100vw"
        formats={['avif', 'webp']}
        alt=""
        class="hero__bg"
        loading="eager"
      />
      <div class="container hero__content">
        <span class="hero__badge">
          <IconPin size={14} />
          {totalUnidades} unidades em {listaCidades}
        </span>
        <h1 class="hero__title">
          <span class="sr-only">{titulo}</span>
          <span class="split" aria-hidden="true">
            {
              palavras.map((palavra, i) => (
                <Fragment>
                  {i > 0 && ' '}
                  <span class="split-word">
                    {[...palavra].map((letra) => (
                      <span class="split-char" style={`--i:${indiceLetra++}`}>
                        {letra}
                      </span>
                    ))}
                  </span>
                </Fragment>
              ))
            }
          </span>
        </h1>
        <p class="hero__subtitle">{porExtenso(totalUnidades, true)} unidades nos principais shoppings de Salvador.</p>
        <div class="hero__actions">
          <button type="button" class="specular-button" data-booking data-booking-origem="hero">Agende agora</button>
          <a href="#unidades" class="hero__link">
            Ver unidades
            <IconArrow size={18} class="hero__link-icon" />
          </a>
        </div>
      </div>
    </div>

    {
      bannersAtivos.map((banner, i) => (
        <div
          class="hero__slide hero__slide--banner"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 2} de ${totalSlides}`}
          data-slide
        >
          <Picture
            src={banner.imagem}
            widths={[640, 1024, 1600]}
            sizes="100vw"
            formats={['avif', 'webp']}
            alt={ALT_BANNER[banner.id] ?? ''}
            class="hero__photo"
            style={banner.posicao ? `object-position: ${banner.posicao}` : undefined}
            loading="lazy"
          />
          <div class="hero__overlay" />
          <div class="container hero__content hero__content--banner">
            <span class="hero__badge">{banner.tag}</span>
            <h2 class="hero__title hero__title--banner">{banner.titulo}</h2>
            <p class="hero__subtitle">{banner.subtitulo}</p>
            <div class="hero__actions">
              <a href={banner.cta.href} class="specular-button">
                {banner.cta.label}
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  {
    comCarrossel && (
      <div class="hero__controls">
        <button type="button" class="hero__pause" aria-label="Pausar destaques" data-carousel-pause>
          <svg class="hero__pause-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M9 6v12M15 6v12" />
          </svg>
          <svg class="hero__play-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M8 5.5v13l10-6.5z" />
          </svg>
        </button>
        <div class="hero__dots">
          {Array.from({ length: totalSlides }, (_, n) => (
            <button
              type="button"
              class="hero__dot"
              aria-label={`Mostrar destaque ${n + 1} de ${totalSlides}`}
              aria-current={n === 0 ? 'true' : 'false'}
              data-carousel-dot={n}
            />
          ))}
        </div>
      </div>
    )
  }
</section>

<script>
  import { initHeroCarousel } from '../../scripts/carousel';
  initHeroCarousel();
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-purple);
    color: var(--color-white);
  }

  .hero__track {
    display: grid;
    touch-action: pan-y;
  }

  /* Slides empilhados na mesma célula: a altura acompanha o slide mais alto */
  .hero__slide {
    position: relative;
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + var(--preview-h) + 40px);
    padding-bottom: 104px;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: opacity 900ms var(--ease), visibility 0s linear 900ms;
  }

  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 900ms var(--ease), visibility 0s;
  }

  .hero__slide--institucional {
    text-align: center;
  }

  .hero__slide :global(.hero__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.12;
    mix-blend-mode: luminosity;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 820px;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 32px;
    padding: 6px 14px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background-color: rgba(107, 31, 124, 0.8);
    border: 1px solid rgba(161, 30, 93, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: var(--radius-20);
  }

  @media (max-width: 400px) {
    .hero__badge {
      padding: 6px 12px;
      font-size: 0.66rem;
      letter-spacing: 0.04em;
    }
  }

  .hero__title {
    margin-bottom: 24px;
    font-size: 2.1rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    text-wrap: balance;
  }

  .split-word {
    display: inline-block;
    white-space: nowrap;
  }

  .split-char {
    display: inline-block;
    animation: charIn 1.25s cubic-bezier(0.215, 0.61, 0.355, 1) both;
    animation-delay: calc(0.2s + var(--i) * 35ms);
  }

  @keyframes charIn {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__subtitle {
    max-width: 640px;
    margin-bottom: 40px;
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.95);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 28px;
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 4px;
    font-weight: 700;
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 6px;
    transition: var(--transition);
  }

  .hero__link:hover {
    text-decoration-color: var(--color-white);
  }

  .hero__link :global(.hero__link-icon) {
    transform: rotate(90deg);
    transition: transform 250ms var(--ease);
  }

  .hero__link:hover :global(.hero__link-icon) {
    transform: rotate(90deg) translateX(4px);
  }

  .hero :global(:focus-visible) {
    outline-color: var(--color-white);
  }

  /* ---------- Banners ---------- */
  .hero__slide--banner {
    align-items: flex-end;
  }

  .hero__slide :global(.hero__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(42, 36, 40, 0.45) 0%, rgba(42, 36, 40, 0) 22%),
      linear-gradient(0deg, rgba(107, 31, 124, 0.96) 0%, rgba(161, 30, 93, 0.82) 42%, rgba(224, 96, 154, 0.3) 72%, rgba(42, 36, 40, 0.1) 100%);
  }

  .hero__content--banner {
    align-items: flex-start;
    text-align: left;
    margin-inline: auto;
  }

  .hero__content--banner .hero__badge {
    margin-bottom: 20px;
  }

  .hero__title--banner {
    font-size: 1.75rem;
    margin-bottom: 16px;
  }

  .hero__content--banner .hero__subtitle {
    margin-bottom: 32px;
  }

  .hero__content--banner .hero__actions {
    justify-content: flex-start;
  }

  .hero__slide--banner.is-active .hero__content > * {
    animation: bannerIn 900ms var(--ease) both;
  }

  .hero__slide--banner.is-active .hero__content > :nth-child(2) { animation-delay: 120ms; }
  .hero__slide--banner.is-active .hero__content > :nth-child(3) { animation-delay: 240ms; }
  .hero__slide--banner.is-active .hero__content > :nth-child(4) { animation-delay: 360ms; }

  @keyframes bannerIn {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Controles ---------- */
  /* No celular, à esquerda, para não ficar sob o botão flutuante (canto direito) */
  .hero__controls {
    position: absolute;
    left: var(--gutter);
    bottom: 28px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (min-width: 768px) {
    .hero__controls {
      left: 50%;
      bottom: 32px;
      gap: 12px;
      transform: translateX(-50%);
    }
  }

  html:not(.js) .hero__controls {
    display: none;
  }

  .hero__pause {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-white);
    background-color: rgba(42, 36, 40, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    transition: var(--transition);
  }

  .hero__pause:hover {
    background-color: rgba(42, 36, 40, 0.45);
  }

  .hero__pause svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero__play-icon,
  .hero__pause.is-paused .hero__pause-icon {
    display: none;
  }

  .hero__pause.is-paused .hero__play-icon {
    display: block;
  }

  .hero__dots {
    display: flex;
    align-items: center;
  }

  /* Área de toque de 32px com o ponto desenhado no ::before */
  .hero__dot {
    position: relative;
    width: 32px;
    height: 32px;
  }

  .hero__dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 10px;
    background-color: rgba(255, 255, 255, 0.45);
    border-radius: var(--radius-pill);
    transform: translate(-50%, -50%);
    transition: var(--transition);
  }

  .hero__dot:hover::before {
    background-color: rgba(255, 255, 255, 0.75);
  }

  .hero__dot[aria-current='true']::before {
    width: 26px;
    background-color: var(--color-white);
  }

  @media (min-width: 768px) {
    .hero__title {
      font-size: 3rem;
    }

    .hero__subtitle {
      font-size: 1.3rem;
    }

    .hero__slide--banner {
      align-items: center;
    }

    .hero__overlay {
      background:
        linear-gradient(180deg, rgba(42, 36, 40, 0.4) 0%, rgba(42, 36, 40, 0) 20%),
        linear-gradient(90deg, rgba(107, 31, 124, 0.95) 0%, rgba(161, 30, 93, 0.8) 38%, rgba(224, 96, 154, 0.25) 68%, rgba(42, 36, 40, 0) 100%);
    }

    .hero__content--banner {
      max-width: var(--container);
    }

    .hero__content--banner > * {
      max-width: 560px;
    }

    .hero__title--banner {
      font-size: 2.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .split-char,
    .hero__slide--banner.is-active .hero__content > * {
      animation: none;
    }
  }
</style>
