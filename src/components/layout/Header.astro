---
import { NAV, SITE } from '../../config/site';
import logoCor from '../../assets/marca/logo-cor.svg';
import IconMenu from '../icons/IconMenu.astro';
import IconClose from '../icons/IconClose.astro';
import IconCalendar from '../icons/IconCalendar.astro';

const atual = Astro.url.pathname;
const ativo = (href: string) => (href === '/' ? atual === '/' : atual.startsWith(href));
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${SITE.nome}, página inicial`}>
      <img src={logoCor.src} width="140" height="43" alt="" class="logo" />
    </a>

    <nav class="site-nav" aria-label="Principal">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={ativo(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button type="button" class="site-header__cta" data-booking data-booking-origem="header">
      <IconCalendar size={18} />
      Agende agora
    </button>

    <button
      type="button"
      class="site-header__toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menu"
      data-menu-toggle
    >
      <IconMenu />
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
  <div class="gradiente-marca mobile-menu__fundo" aria-hidden="true"></div>
  <div class="mobile-menu__top container">
    <img src={logoCor.src} width="140" height="43" alt={SITE.nome} class="logo" />
    <button type="button" class="mobile-menu__close" aria-label="Fechar menu" data-menu-close>
      <IconClose />
    </button>
  </div>
  <nav aria-label="Menu" class="mobile-menu__nav container">
    <ul>
      {
        NAV.map((item, i) => (
          <li style={`--n:${i}`}>
            <a href={item.href} aria-current={ativo(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <button type="button" class="specular-button specular-button--dark" style={`--n:${NAV.length}`} data-booking data-booking-origem="header">
      Agende agora
    </button>
  </nav>
</div>

<style>
  /* Header fixo. No topo da página ele fica dentro da moldura do hero (desce --frame-inset);
     depois de rolar, sobe para o topo com fundo branco. Grade de 3 colunas: logo, menu, botão. */
  .site-header {
    position: fixed;
    top: calc(var(--preview-h) + var(--frame-inset));
    left: 0;
    right: 0;
    z-index: 90;
    height: var(--header-h);
    color: var(--color-purple);
    view-transition-name: cabecalho;
    transition:
      top 400ms var(--ease-out-expo),
      background-color 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }

  .site-header.is-scrolled {
    top: var(--preview-h);
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(99, 32, 102, 0.08);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    height: 100%;
  }

  .site-header__logo {
    display: block;
    justify-self: start;
    width: 118px;
    /* o logo tem a assinatura embaixo; sobe 2px para o centro ótico bater com o menu */
    margin-top: -2px;
  }

  .logo {
    width: 100%;
    height: auto;
  }

  .site-nav {
    display: none;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
  }

  .site-nav a {
    position: relative;
    display: block;
    padding: 10px 14px;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-purple);
    transition: color 250ms var(--ease);
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 2px;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 350ms var(--ease-out-expo);
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-nav a:hover {
    color: var(--color-pink-dark);
  }

  .site-header__cta {
    display: none;
    justify-self: end;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px 0 16px;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-white);
    background: var(--color-purple);
    border-radius: var(--radius-pill);
    transition: background-color 250ms var(--ease);
  }

  .site-header__cta:hover {
    background: var(--color-purple-hover);
  }

  .site-header__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: end;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    color: var(--color-purple);
    border-radius: 50%;
  }

  @media (min-width: 1024px) {
    .site-header__inner {
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__logo {
      width: 132px;
    }

    .site-nav,
    .site-header__cta {
      display: flex;
    }

    .site-header__toggle {
      display: none;
    }
  }

  /* ---------- Menu mobile ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    flex-direction: column;
    color: var(--color-purple);
    isolation: isolate;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* O gradiente fica preso à tela enquanto o menu rola */
  .mobile-menu__fundo {
    position: fixed;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  /* Entrada: o painel desce como uma cortina (clip-path, sem transform no pai para o fundo
     fixo não pular) e os itens sobem em sequência. Saída: tudo recolhe para cima, mais rápido. */
  .mobile-menu.is-open {
    animation: menuAbre 560ms var(--ease-out-expo) both;
  }

  .mobile-menu.is-open .mobile-menu__top,
  .mobile-menu.is-open li,
  .mobile-menu.is-open .specular-button {
    animation: menuItemEntra 640ms var(--ease-out-expo) both;
    animation-delay: calc(140ms + var(--n, 0) * 45ms);
  }

  .mobile-menu.is-open .mobile-menu__top {
    animation-delay: 80ms;
  }

  .mobile-menu.is-closing {
    animation: menuFecha 340ms cubic-bezier(0.7, 0, 0.84, 0) both;
  }

  .mobile-menu.is-closing .mobile-menu__top,
  .mobile-menu.is-closing li,
  .mobile-menu.is-closing .specular-button {
    animation: menuItemSai 200ms var(--ease) both;
  }

  @keyframes menuAbre {
    from {
      opacity: 0.4;
      clip-path: inset(0 0 100% 0 round 0 0 40px 40px);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0 round 0);
    }
  }

  @keyframes menuFecha {
    from {
      opacity: 1;
      clip-path: inset(0 0 0 0 round 0);
    }
    to {
      opacity: 0.6;
      clip-path: inset(0 0 100% 0 round 0 0 40px 40px);
    }
  }

  @keyframes menuItemEntra {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
  }

  @keyframes menuItemSai {
    to {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu.is-open,
    .mobile-menu.is-closing,
    .mobile-menu.is-open *,
    .mobile-menu.is-closing * {
      animation: none !important;
    }
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    margin-top: calc(var(--preview-h) + var(--frame-inset));
  }

  .mobile-menu__top .logo {
    width: 118px;
  }

  .mobile-menu__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 32px;
    padding-bottom: 48px;
  }

  .mobile-menu__nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-menu__nav a {
    display: inline-block;
    padding: 6px 0;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    opacity: 0.8;
  }

  .mobile-menu__nav a[aria-current='page'] {
    opacity: 1;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  .mobile-menu__nav .specular-button {
    align-self: flex-start;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const close = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  // Fundo branco após rolar
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menu mobile: abre com .is-open; fecha com .is-closing e só esconde no fim da animação
  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)');
  let timerFechar: number | undefined;

  function abrir() {
    if (!menu || !toggle) return;
    window.clearTimeout(timerFechar);
    menu.classList.remove('is-closing');
    menu.hidden = false;
    menu.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    close?.focus({ preventScroll: true });
  }

  function esconder() {
    if (!menu) return;
    menu.hidden = true;
    menu.classList.remove('is-open', 'is-closing');
    document.body.style.overflow = '';
  }

  function fechar(devolverFoco = true, imediato = false) {
    if (!menu || !toggle || menu.hidden || menu.classList.contains('is-closing')) return;
    toggle.setAttribute('aria-expanded', 'false');
    if (devolverFoco) toggle.focus({ preventScroll: true });
    if (imediato || semMovimento.matches) return esconder();
    menu.classList.remove('is-open');
    menu.classList.add('is-closing');
    timerFechar = window.setTimeout(esconder, 340);
  }

  toggle?.addEventListener('click', abrir);
  close?.addEventListener('click', () => fechar());
  // Links para outra página: o menu continua aberto e a transição de página cuida da troca.
  // Âncoras na mesma página e o agendamento fecham o menu antes.
  menu?.querySelectorAll<HTMLElement>('a, [data-booking]').forEach((el) =>
    el.addEventListener('click', () => {
      const href = el.getAttribute('href');
      const outraPagina = href && !href.startsWith('#') && new URL(href, location.href).pathname !== location.pathname;
      if (!outraPagina) fechar(false);
    }),
  );

  // Voltar pelo navegador (página restaurada do cache): menu fechado
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) fechar(false, true);
  });

  document.addEventListener('keydown', (e) => {
    if (!menu || menu.hidden) return;
    if (e.key === 'Escape') fechar();
    // Mantém o foco dentro do painel
    if (e.key === 'Tab') {
      const focaveis = menu.querySelectorAll<HTMLElement>('a, button');
      const primeiro = focaveis[0];
      const ultimo = focaveis[focaveis.length - 1];
      if (e.shiftKey && document.activeElement === primeiro) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primeiro.focus();
      }
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) fechar(false);
  });
</script>
