---
import { NAV, SITE, HORARIO } from '../../config/site';
import { unidadesAtivas } from '../../lib/unidades';
import logoCor from '../../assets/marca/logo-cor.svg';
import IconInstagram from '../icons/IconInstagram.astro';

const ano = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <img src={logoCor.src} width="150" height="46" alt={SITE.nome} loading="lazy" />
      <p>{SITE.assinatura}</p>
      <a
        href={SITE.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="site-footer__insta"
      >
        <IconInstagram size={18} />
        {SITE.instagramUsuario}
      </a>
    </div>

    <nav aria-label="Rodapé" class="site-footer__col">
      <h2 class="site-footer__title">Navegue</h2>
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2 class="site-footer__title">Nossas unidades</h2>
      <ul>
        {unidadesAtivas.map((u) => <li><a href={`/lojas/#${u.slug}`}>{u.nome}</a></li>)}
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__title">Horário</h2>
      <ul class="site-footer__horario">
        {HORARIO.linhas.map((l) => <li><strong>{l.dias}</strong> {l.horas}</li>)}
      </ul>
      <p class="site-footer__nota">{HORARIO.nota}</p>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {ano} {SITE.razao}. Todos os direitos reservados.</p>
    <p>
      Desenvolvido por{' '}
      <a href={SITE.desenvolvedor.url} target="_blank" rel="noopener noreferrer">
        {SITE.desenvolvedor.nome}
      </a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: 56px;
    padding-bottom: 96px; /* espaço para o botão flutuante (só abaixo de 1024px) */
    font-size: 0.9rem;
    background-color: var(--color-neutral-bg);
    border-top: 1px solid var(--color-line);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 24px;
  }

  .site-footer__brand {
    grid-column: 1 / -1;
  }

  .site-footer__brand img {
    width: 150px;
    height: auto;
    margin-bottom: 16px;
  }

  .site-footer__brand p {
    max-width: 280px;
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-purple);
  }

  .site-footer__insta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--color-pink-dark);
    transition: color 250ms var(--ease);
  }

  .site-footer__insta:hover {
    color: var(--color-purple);
  }

  .site-footer__title {
    margin-bottom: 14px;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-purple);
  }

  .site-footer__col ul {
    display: grid;
    gap: 8px;
    list-style: none;
  }

  .site-footer__col a {
    color: var(--color-text-muted);
    transition: color 250ms var(--ease);
  }

  .site-footer__col a:hover {
    color: var(--color-pink-dark);
  }

  .site-footer__horario li {
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .site-footer__horario strong {
    display: block;
    font-weight: 600;
    color: var(--color-purple-dark);
  }

  .site-footer__nota {
    margin-top: 10px;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 48px;
    padding-top: 24px;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-line);
  }

  .site-footer__bottom a {
    font-weight: 600;
    color: var(--color-pink-dark);
    transition: color 250ms var(--ease);
  }

  .site-footer__bottom a:hover {
    color: var(--color-purple);
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
      gap: 40px;
    }

    .site-footer__brand {
      grid-column: auto;
    }

    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) {
    .site-footer {
      padding-bottom: 40px;
    }
  }
</style>
