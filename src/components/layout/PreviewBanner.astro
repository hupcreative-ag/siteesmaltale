---
import { IS_PRODUCTION } from '../../config/site';
---

{!IS_PRODUCTION && <div class="preview-banner" role="note">Versão de prévia</div>}

<style>
  .preview-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--preview-h);
    view-transition-name: faixa-previa;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-white);
    background: var(--color-purple-dark);
  }
</style>
