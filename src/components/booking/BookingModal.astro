---
/**
 * Modal de agendamento em <dialog> nativo, em duas etapas:
 * 1. "Em qual unidade?" (lista com miniatura)  2. Ficha da unidade (foto, localização, endereço)
 *    com os canais: Trinks (principal) e WhatsApp.
 * No celular abre como folha que sobe da base da tela.
 *
 * Abre com qualquer elemento [data-booking]:
 *   data-booking-origem   header | flutuante | hero | card_servico | card_unidade | faixa_contato | pagina_servico | faq
 *   data-booking-modo     agendamento (padrão) | duvida
 *   data-booking-unidade  slug: pula direto para a etapa 2
 */
import { getImage } from 'astro:assets';
import {
  unidadesAtivas,
  localizacao,
  enderecoCompleto,
  whatsappAgendamento,
  whatsappDuvida,
} from '../../lib/unidades';
import logoCor from '../../assets/marca/logo-cor.svg';
import IconClose from '../icons/IconClose.astro';
import IconArrow from '../icons/IconArrow.astro';
import IconCalendar from '../icons/IconCalendar.astro';
import IconWhatsapp from '../icons/IconWhatsapp.astro';

const unidades = await Promise.all(
  unidadesAtivas.map(async (u) => ({
    u,
    mini: u.foto ? (await getImage({ src: u.foto, width: 112, height: 112, format: 'webp' })).src : null,
    foto: u.foto ? (await getImage({ src: u.foto, width: 880, height: 440, format: 'webp' })).src : null,
  })),
);

const dados = unidades.map(({ u, foto }) => ({
  slug: u.slug,
  nome: u.nome,
  local: localizacao(u, true),
  endereco: enderecoCompleto(u),
  foto,
  fotoPosicao: u.fotoPosicao ?? 'center',
  trinksUrl: u.trinksUrl ?? null,
  waAgendamento: whatsappAgendamento(u),
  waDuvida: whatsappDuvida(u),
}));
---

<dialog class="booking-modal" aria-labelledby="booking-titulo-unidade" data-booking-modal>
  <div class="modal-card">
    <button type="button" class="modal-close" aria-label="Fechar" data-modal-close>
      <IconClose size={20} />
    </button>

    <!-- Etapa 1 -->
    <div class="modal-step" data-step="unidade">
      <header class="modal-header">
        <h2 id="booking-titulo-unidade" tabindex="-1">Em qual unidade?</h2>
        <p class="modal-subtitle" data-subtitulo-agendamento>
          Escolha a unidade mais perto de você para seguir com o agendamento.
        </p>
        <p class="modal-subtitle" data-subtitulo-duvida hidden>
          Escolha a unidade e fale direto com a recepção pelo WhatsApp.
        </p>
      </header>

      <ul class="unit-options" data-unit-list>
        {
          unidades.map(({ u, mini }) => (
            <li data-slug={u.slug}>
              <button type="button" class="unit-option" data-escolher={u.slug}>
                {mini ? (
                  <img src={mini} width="56" height="56" alt="" class="unit-option__foto" loading="lazy" />
                ) : (
                  <span class="unit-option__foto unit-option__foto--vazia brand-gradient" />
                )}
                <span class="unit-option__text">
                  <span class="unit-option__nome">
                    {u.nome}
                    {u.novidade && <span class="tag">Nova</span>}
                    <span class="tag tag--last" hidden>
                      Última escolhida
                    </span>
                  </span>
                  <span class="unit-option__local">{localizacao(u)}</span>
                </span>
                <IconArrow size={18} class="unit-option__seta" />
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Etapa 2 -->
    <div class="modal-step" data-step="canal" hidden>
      <button type="button" class="modal-back" data-voltar>
        <IconArrow size={16} />
        Voltar
      </button>

      <div class="ficha">
        <div class="ficha__foto">
          <img src={dados.find((d) => d.foto)?.foto ?? logoCor.src} alt="" width="440" height="220" loading="lazy" data-ficha-foto hidden />
          <span class="ficha__vazia brand-gradient" data-ficha-vazia>
            <img src={logoCor.src} width="140" height="43" alt="" />
          </span>
        </div>
        <h2 class="ficha__nome" id="booking-titulo-canal" tabindex="-1" data-nome-unidade></h2>
        <p class="ficha__local" data-ficha-local></p>
        <p class="ficha__endereco" data-ficha-endereco></p>
      </div>

      <p class="modal-pergunta">Como prefere agendar?</p>
      <div class="modal-body" data-canais>
        <a href="#" target="_blank" rel="noopener noreferrer" class="canal canal--principal" data-canal-trinks>
          <IconCalendar size={20} />
          <span class="canal__texto">
            <strong>Agendamento online (Trinks)</strong>
            <span>Escolha profissional e horário na hora</span>
          </span>
          <IconArrow size={18} class="canal__seta" />
        </a>
        <a href="#" target="_blank" rel="noopener noreferrer" class="canal" data-canal-whatsapp>
          <IconWhatsapp size={20} />
          <span class="canal__texto">
            <strong>Agendar pelo WhatsApp</strong>
            <span>Fale com a nossa recepção por mensagem</span>
          </span>
          <IconArrow size={18} class="canal__seta" />
        </a>
      </div>
    </div>
  </div>
</dialog>

<script type="application/json" id="booking-data" set:html={JSON.stringify(dados)} />

<style>
  .booking-modal {
    width: min(440px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    overflow: visible;
    color: var(--color-purple-dark);
    background: transparent;
    border: none;
  }

  /* Entrada e saída suaves; o fundo desfocado também entra e sai aos poucos */
  .booking-modal[open] {
    animation: modalIn 460ms var(--ease-out-expo) both;
  }

  .booking-modal.is-closing {
    animation: modalOut 260ms var(--ease) both;
  }

  .booking-modal::backdrop {
    background: rgba(54, 33, 58, 0.42);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .booking-modal[open]::backdrop {
    animation: backdropIn 500ms var(--ease-out-expo) both;
  }

  .booking-modal.is-closing::backdrop {
    animation: backdropOut 260ms var(--ease) both;
  }

  @keyframes modalIn {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }

  @keyframes modalOut {
    to { opacity: 0; transform: translateY(10px) scale(0.98); }
  }

  @keyframes backdropIn {
    from {
      background-color: rgba(54, 33, 58, 0);
      backdrop-filter: blur(0);
      -webkit-backdrop-filter: blur(0);
    }
  }

  @keyframes backdropOut {
    to {
      background-color: rgba(54, 33, 58, 0);
      backdrop-filter: blur(0);
      -webkit-backdrop-filter: blur(0);
    }
  }

  .modal-card {
    position: relative;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 28px 24px 24px;
    background: var(--color-white);
    border-radius: 28px;
    box-shadow: 0 30px 60px -20px rgba(54, 33, 58, 0.45);
  }

  /* Celular: folha que sobe da base */
  @media (max-width: 639px) {
    .booking-modal {
      width: 100%;
      max-width: 100%;
      margin: auto 0 0;
    }

    .booking-modal[open] {
      animation: sheetIn 520ms var(--ease-out-expo) both;
    }

    .booking-modal.is-closing {
      animation: sheetOut 300ms var(--ease) both;
    }

    .modal-card {
      max-height: 88dvh;
      padding: 30px 20px calc(20px + env(safe-area-inset-bottom));
      border-radius: 24px 24px 0 0;
    }

    /* alça */
    .modal-card::before {
      content: '';
      position: absolute;
      top: 10px;
      left: 50%;
      width: 40px;
      height: 4px;
      background: rgba(99, 32, 102, 0.15);
      border-radius: 4px;
      transform: translateX(-50%);
    }
  }

  @keyframes sheetIn {
    from { transform: translateY(100%); }
    to { transform: none; }
  }

  @keyframes sheetOut {
    to { transform: translateY(100%); }
  }

  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-purple);
    background: var(--color-neutral-bg);
    border-radius: 50%;
    transition: background-color 250ms var(--ease);
  }

  .modal-close:hover {
    background: var(--color-blush);
  }

  .modal-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: -6px 0 14px;
    padding: 6px 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-purple);
  }

  .modal-back[hidden] {
    display: none;
  }

  .modal-back :global(.icon) {
    transform: rotate(180deg);
    transition: transform 250ms var(--ease);
  }

  .modal-back:hover :global(.icon) {
    transform: rotate(180deg) translateX(3px);
  }

  .modal-header {
    margin-bottom: 18px;
    padding-right: 44px;
  }

  .modal-header h2,
  .ficha__nome {
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--color-purple);
  }

  .modal-header h2:focus,
  .ficha__nome:focus {
    outline: none;
  }

  .modal-subtitle {
    margin-top: 6px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* ---------- Etapa 1: lista ---------- */
  .unit-options {
    list-style: none;
  }

  .unit-options li + li {
    border-top: 1px solid var(--color-line);
  }

  .unit-option {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 12px 4px;
    text-align: left;
    border-radius: 14px;
    transition: background-color 250ms var(--ease);
  }

  .unit-option:hover {
    background: var(--color-neutral-bg);
  }

  .unit-option__foto {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 12px;
  }

  .unit-option__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .unit-option__nome {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-purple-dark);
  }

  .unit-option__local {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .unit-option :global(.unit-option__seta) {
    flex-shrink: 0;
    color: var(--color-purple);
    opacity: 0.5;
    transition: transform 300ms var(--ease-out-expo), opacity 250ms var(--ease);
  }

  .unit-option:hover :global(.unit-option__seta) {
    opacity: 1;
    transform: translateX(3px);
  }

  .tag {
    padding: 2px 7px;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-pink-dark);
    background: var(--color-blush);
    border-radius: var(--radius-pill);
  }

  .tag[hidden] {
    display: none;
  }

  .tag--last {
    color: var(--color-purple);
    background: var(--color-neutral-bg);
  }

  /* ---------- Etapa 2: ficha da unidade ---------- */
  .ficha__foto {
    position: relative;
    aspect-ratio: 2 / 1;
    margin-bottom: 16px;
    overflow: hidden;
    border-radius: 18px;
  }

  .ficha__foto img[data-ficha-foto] {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ficha__foto img[hidden],
  .ficha__vazia[hidden] {
    display: none;
  }

  .ficha__vazia {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .ficha__local {
    margin-top: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-purple);
  }

  .ficha__endereco {
    margin-top: 2px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .modal-pergunta {
    margin: 22px 0 10px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .modal-body {
    display: grid;
    gap: 8px;
  }

  .canal {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    color: var(--color-purple);
    background: var(--color-neutral-bg);
    border-radius: 16px;
    transition: background-color 250ms var(--ease), color 250ms var(--ease);
  }

  .canal[hidden] {
    display: none;
  }

  .canal:hover {
    background: var(--color-blush);
  }

  .canal--principal {
    color: var(--color-white);
    background: var(--color-purple);
  }

  .canal--principal:hover {
    background: var(--color-purple-hover);
  }

  .canal__texto {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .canal__texto strong {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .canal__texto span {
    font-size: 0.78rem;
    opacity: 0.8;
  }

  .canal :global(.canal__seta) {
    transition: transform 300ms var(--ease-out-expo);
  }

  .canal:hover :global(.canal__seta) {
    transform: translateX(3px);
  }
</style>

<script>
  import { trackOpenModal, trackSelectUnit, gtagEvent, fbqEvent } from '../../scripts/analytics';

  type Modo = 'agendamento' | 'duvida';
  interface DadosUnidade {
    slug: string;
    nome: string;
    local: string;
    endereco: string;
    foto: string | null;
    fotoPosicao: string;
    trinksUrl: string | null;
    waAgendamento: string;
    waDuvida: string;
  }

  const CHAVE = 'esmaltale:ultima-unidade';
  const dialog = document.querySelector<HTMLDialogElement>('[data-booking-modal]')!;
  const unidades: DadosUnidade[] = JSON.parse(
    document.getElementById('booking-data')?.textContent || '[]',
  );
  const porSlug = new Map(unidades.map((u) => [u.slug, u]));

  const etapaUnidade = dialog.querySelector<HTMLElement>('[data-step="unidade"]')!;
  const etapaCanal = dialog.querySelector<HTMLElement>('[data-step="canal"]')!;
  const lista = dialog.querySelector<HTMLUListElement>('[data-unit-list]')!;
  const linkTrinks = dialog.querySelector<HTMLAnchorElement>('[data-canal-trinks]')!;
  const linkWhatsapp = dialog.querySelector<HTMLAnchorElement>('[data-canal-whatsapp]')!;
  const nomeUnidade = dialog.querySelector<HTMLElement>('[data-nome-unidade]')!;
  const canais = dialog.querySelector<HTMLElement>('[data-canais]')!;
  const voltar = dialog.querySelector<HTMLButtonElement>('[data-voltar]')!;
  const fichaFoto = dialog.querySelector<HTMLImageElement>('[data-ficha-foto]')!;
  const fichaVazia = dialog.querySelector<HTMLElement>('[data-ficha-vazia]')!;
  const fichaLocal = dialog.querySelector<HTMLElement>('[data-ficha-local]')!;
  const fichaEndereco = dialog.querySelector<HTMLElement>('[data-ficha-endereco]')!;

  let modo: Modo = 'agendamento';

  function lerUltima(): string | null {
    try {
      return localStorage.getItem(CHAVE);
    } catch {
      return null;
    }
  }

  function salvarUltima(slug: string) {
    try {
      localStorage.setItem(CHAVE, slug);
    } catch {
      /* armazenamento indisponível: segue sem lembrar */
    }
  }

  /** Coloca a última unidade escolhida no topo, com a etiqueta. */
  function ordenarLista() {
    const ultima = lerUltima();
    lista.querySelectorAll<HTMLElement>('.tag--last').forEach((t) => (t.hidden = true));
    if (!ultima || !porSlug.has(ultima)) return;
    const item = lista.querySelector<HTMLElement>(`li[data-slug="${ultima}"]`);
    if (!item) return;
    lista.prepend(item);
    item.querySelector<HTMLElement>('.tag--last')!.hidden = false;
  }

  function mostrarEtapa(etapa: 'unidade' | 'canal') {
    etapaUnidade.hidden = etapa !== 'unidade';
    etapaCanal.hidden = etapa !== 'canal';
    const titulo = etapa === 'unidade' ? 'booking-titulo-unidade' : 'booking-titulo-canal';
    dialog.setAttribute('aria-labelledby', titulo);
    if (dialog.open) document.getElementById(titulo)?.focus();
  }

  /** Abre o WhatsApp em nova aba e registra o evento (não passa pela delegação de links). */
  function abrirWhatsapp(u: DadosUnidade, url: string) {
    gtagEvent('generate_lead', { unit: u.slug });
    gtagEvent('click_whatsapp', { unit: u.slug });
    fbqEvent('track', 'Contact');
    window.open(url, '_blank', 'noopener,noreferrer');
  }

  function prepararCanais(u: DadosUnidade) {
    nomeUnidade.textContent = u.nome;
    fichaLocal.textContent = u.local;
    fichaEndereco.textContent = u.endereco;
    fichaFoto.hidden = !u.foto;
    fichaVazia.hidden = !!u.foto;
    if (u.foto) {
      fichaFoto.src = u.foto;
      fichaFoto.alt = `Unidade Esmaltale ${u.nome}`;
      fichaFoto.style.objectPosition = u.fotoPosicao;
    }
    canais.dataset.unit = u.slug;
    linkWhatsapp.href = u.waAgendamento;
    linkTrinks.hidden = !u.trinksUrl;
    if (u.trinksUrl) linkTrinks.href = u.trinksUrl;
  }

  /** Decide o próximo passo depois que a unidade é conhecida. Retorna true se o modal deve ficar aberto. */
  function seguirComUnidade(u: DadosUnidade): boolean {
    salvarUltima(u.slug);
    if (modo === 'duvida') {
      abrirWhatsapp(u, u.waDuvida);
      return false;
    }
    if (!u.trinksUrl) {
      abrirWhatsapp(u, u.waAgendamento);
      return false;
    }
    prepararCanais(u);
    return true;
  }

  function abrir(origem: string, novoModo: Modo, slug?: string) {
    modo = novoModo;
    dialog.querySelector<HTMLElement>('[data-subtitulo-agendamento]')!.hidden = modo !== 'agendamento';
    dialog.querySelector<HTMLElement>('[data-subtitulo-duvida]')!.hidden = modo !== 'duvida';
    trackOpenModal(origem, modo);

    const unidade = slug ? porSlug.get(slug) : undefined;
    if (unidade) {
      if (!seguirComUnidade(unidade)) return;
      voltar.hidden = true;
      mostrarEtapa('canal');
    } else {
      ordenarLista();
      voltar.hidden = false;
      mostrarEtapa('unidade');
    }

    dialog.showModal();
    document.body.style.overflow = 'hidden';
  }

  /** Fecha com a animação de saída (o close nativo é instantâneo). */
  let fechando = false;
  function fechar() {
    if (!dialog.open || fechando) return;
    fechando = true;
    dialog.classList.add('is-closing');
    const reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.setTimeout(
      () => {
        dialog.classList.remove('is-closing');
        fechando = false;
        dialog.close();
      },
      reduz ? 0 : 290,
    );
  }

  // Esc também usa a saída animada
  dialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    fechar();
  });

  dialog.addEventListener('close', () => {
    // O evento chega de forma assíncrona: se o modal já foi reaberto, não reseta.
    if (dialog.open) return;
    document.body.style.overflow = '';
    mostrarEtapa('unidade');
  });

  // Clique fora do cartão fecha
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) fechar();
  });

  dialog.querySelector('[data-modal-close]')?.addEventListener('click', fechar);
  voltar.addEventListener('click', () => {
    ordenarLista();
    mostrarEtapa('unidade');
  });

  lista.addEventListener('click', (e) => {
    const botao = (e.target as Element).closest<HTMLButtonElement>('[data-escolher]');
    const u = botao && porSlug.get(botao.dataset.escolher!);
    if (!u) return;
    trackSelectUnit(u.slug);
    if (seguirComUnidade(u)) mostrarEtapa('canal');
    else fechar();
  });

  // Depois de escolher o canal, o link abre em nova aba e o modal fecha
  canais.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setTimeout(fechar, 150);
  });

  // Gatilhos em qualquer lugar da página
  document.addEventListener('click', (e) => {
    const gatilho = (e.target as Element | null)?.closest<HTMLElement>('[data-booking]');
    if (!gatilho) return;
    e.preventDefault();
    const { bookingOrigem = 'desconhecida', bookingModo, bookingUnidade } = gatilho.dataset;
    abrir(bookingOrigem, bookingModo === 'duvida' ? 'duvida' : 'agendamento', bookingUnidade);
  });
</script>
