---
/**
 * Unidade na Home: card com foto, nome e localização. As ações (Trinks e WhatsApp) ficam
 * sobre a foto e aparecem no hover ou no foco do teclado; em tablets de toque ficam sempre visíveis.
 * Celular (< 640px): card compacto em grade de 2 colunas (foto, nome e "Agendar"); o botão abre
 * o modal já na unidade, com foto, piso, referência, endereço, Trinks e WhatsApp. "Conhecer a unidade" fica só em Lojas.
 * Sem foto: gradiente da marca com o logo branco. Sem trinksUrl esconde o Trinks.
 * data-unit alimenta o tracking (src/scripts/analytics.ts).
 */
import { Picture } from 'astro:assets';
import type { Unidade } from '../../data/unidades';
import { localizacao, whatsappAgendamento } from '../../lib/unidades';
import logoCor from '../../assets/marca/logo-cor.svg';
import IconWhatsapp from '../icons/IconWhatsapp.astro';

interface Props {
  unidade: Unidade;
}

const { unidade: u } = Astro.props;
const externo = { target: '_blank', rel: 'noopener noreferrer' };
---

<article class="unit" data-unit={u.slug}>
  <div class="unit__media">
    {
      u.foto ? (
        <Picture
          src={u.foto}
          width={720}
          height={540}
          widths={[360, 540, 720]}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 46vw, 46vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          alt={`Unidade Esmaltale ${u.nome}, esmalteria em ${u.cidade}`}
          class="unit__img"
          style={u.fotoPosicao ? `object-position: ${u.fotoPosicao}` : undefined}
          loading="lazy"
        />
      ) : (
        <div class="unit__fallback brand-gradient">
          <img src={logoCor.src} width="140" height="43" alt="" />
        </div>
      )
    }
    {u.novidade && <span class="unit__tag">Nova unidade</span>}

    <div class="unit__actions">
      {
        u.trinksUrl && (
          <a href={u.trinksUrl} class="unit__btn unit__btn--primary" {...externo}>
            Agendar via Trinks<span class="sr-only">, {u.nome}</span>
          </a>
        )
      }
      <a href={whatsappAgendamento(u)} class="unit__btn" {...externo}>
        <IconWhatsapp size={16} />
        Fale com a recepção<span class="sr-only">, {u.nome}</span>
      </a>
    </div>
  </div>

  <div class="unit__info">
    <h3 class="unit__name">{u.nome}</h3>
    <p class="unit__loc">{[u.cidade, localizacao(u)].join(' · ')}</p>
    <button
      type="button"
      class="unit__agendar"
      data-booking
      data-booking-origem="card_unidade"
      data-booking-unidade={u.slug}
    >
      Agendar<span class="sr-only"> na unidade {u.nome}</span>
    </button>
  </div>
</article>

<style>
  .unit {
    position: relative;
    height: 100%;
    padding: 10px 10px 18px;
    background-color: var(--color-white);
    border: 1px solid rgba(107, 31, 124, 0.08);
    border-radius: 20px;
    box-shadow: 0 1px 2px rgba(42, 36, 40, 0.04), 0 8px 24px -12px rgba(107, 31, 124, 0.12);
    transition: box-shadow 400ms var(--ease-out-expo), border-color 400ms var(--ease-out-expo);
  }

  .unit__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
    isolation: isolate;
  }

  .unit__media :global(.unit__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out-expo);
  }

  .unit__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .unit__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 5px 10px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-pink-dark);
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: var(--radius-pill);
  }

  /* Ações sobre a base da foto, com degradê para leitura */
  .unit__actions {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 40px 12px 12px;
    background: linear-gradient(to top, rgba(42, 36, 40, 0.6), rgba(42, 36, 40, 0));
  }

  .unit__btn {
    display: inline-flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 14px;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--color-white);
    background-color: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: background-color 250ms var(--ease), color 250ms var(--ease), border-color 250ms var(--ease);
  }

  .unit__btn:hover {
    background-color: rgba(255, 255, 255, 0.28);
  }

  .unit__btn--primary {
    color: var(--color-purple);
    background-color: var(--color-white);
    border-color: var(--color-white);
  }

  .unit__btn--primary:hover {
    color: var(--color-white);
    background-color: var(--color-purple);
    border-color: var(--color-purple);
  }

  .unit__btn :global(.icon) {
    width: 16px;
    height: 16px;
  }

  .unit__info {
    padding: 16px 8px 0;
  }

  .unit__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-purple);
  }

  .unit__loc {
    margin-top: 2px;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .unit__agendar {
    display: none;
  }

  /* Celular: card compacto, 2 por linha; ações pelo modal */
  @media (max-width: 639px) {
    .unit {
      display: flex;
      flex-direction: column;
      padding: 6px 6px 12px;
      border-radius: 16px;
    }

    .unit__media {
      aspect-ratio: 4 / 3;
      border-radius: 11px;
    }

    .unit__actions {
      display: none;
    }

    .unit__tag {
      top: 6px;
      left: 6px;
      padding: 3px 7px;
      font-size: 0.5625rem;
    }

    .unit__info {
      display: flex;
      flex: 1;
      flex-direction: column;
      padding: 10px 6px 0;
    }

    .unit__name {
      font-size: 1.0625rem;
      line-height: 1.15;
    }

    /* Piso e referência ficam no modal, que abre com a foto e o endereço */
    .unit__loc {
      display: none;
    }

    .unit__name {
      margin-bottom: 10px;
    }

    .unit__agendar {
      display: inline-flex;
      align-self: flex-start;
      align-items: center;
      height: 32px;
      margin-top: auto;
      padding: 0 14px;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-white);
      background-color: var(--color-purple);
      border-radius: var(--radius-pill);
    }
  }

  /* Mouse: ações escondidas até o hover ou o foco */
  @media (hover: hover) and (pointer: fine) {
    .unit__actions {
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 350ms var(--ease-out-expo),
        transform 500ms var(--ease-out-expo);
    }

    .unit:hover .unit__actions,
    .unit:focus-within .unit__actions {
      opacity: 1;
      transform: none;
    }

    .unit:hover {
      border-color: rgba(107, 31, 124, 0.16);
      box-shadow: 0 1px 2px rgba(42, 36, 40, 0.04), 0 18px 40px -18px rgba(107, 31, 124, 0.28);
    }

    .unit:hover :global(.unit__img) {
      transform: scale(1.04);
    }
  }
</style>
