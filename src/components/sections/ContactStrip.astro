---
/** Faixa de contato antes do rodapé. Somente em Sobre, Nail Design e Podologia.
    Cartão creme com filete fino (estilo Beauty Ticket); o botão abre o modal no modo dúvida. */
import IconWhatsapp from '../icons/IconWhatsapp.astro';
---

<section class="contact-strip" aria-labelledby="contact-strip-title">
  <div class="container">
    <div class="contact-strip__cartao" data-reveal>
      <svg class="contact-strip__brilhos" viewBox="0 0 64 24" aria-hidden="true" focusable="false">
        <path d="M12 4c.6 3.6 1.9 5 5.4 5.6-3.5.6-4.8 2-5.4 5.6-.6-3.6-1.9-5-5.4-5.6 3.5-.6 4.8-2 5.4-5.6z" />
        <path d="M32 0c.9 5.4 2.9 7.5 8.1 8.4-5.2.9-7.2 3-8.1 8.4-.9-5.4-2.9-7.5-8.1-8.4 5.2-.9 7.2-3 8.1-8.4z" />
        <path d="M52 4c.6 3.6 1.9 5 5.4 5.6-3.5.6-4.8 2-5.4 5.6-.6-3.6-1.9-5-5.4-5.6 3.5-.6 4.8-2 5.4-5.6z" />
      </svg>
      <h2 id="contact-strip-title" class="contact-strip__title">Dúvidas ou precisa de ajuda?</h2>
      <button
        type="button"
        class="contact-strip__btn"
        data-booking
        data-booking-modo="duvida"
        data-booking-origem="faixa_contato"
      >
        <IconWhatsapp size={18} />
        Atendimento via WhatsApp
      </button>
    </div>
  </div>
</section>

<style>
  .contact-strip {
    padding-block: 40px 56px;
    background-color: var(--color-white);
  }

  /* Depois do CTA final (fundo branco) o respiro já existe */
  :global(main:has(> .cta-final-wrap:last-child)) + .contact-strip {
    padding-top: 0;
  }

  .contact-strip__cartao {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 36px 24px;
    text-align: center;
    background-color: var(--color-creme);
    border: 1px solid var(--color-line);
    border-radius: 24px;
  }

  .contact-strip__brilhos {
    width: 44px;
    fill: var(--color-pink);
  }

  .contact-strip__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.15;
    color: var(--color-purple);
  }

  .contact-strip__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 24px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-white);
    background-color: var(--color-purple);
    border-radius: var(--radius-pill);
    transition: background-color 250ms var(--ease);
  }

  .contact-strip__btn:hover {
    background-color: var(--color-purple-hover);
  }

  @media (min-width: 768px) {
    .contact-strip {
      padding-block: 56px 88px;
    }

    .contact-strip__cartao {
      flex-direction: row;
      justify-content: center;
      gap: 28px;
      padding: 40px 48px;
    }
  }
</style>
