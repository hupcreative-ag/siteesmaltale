---
/** Faixa de contato antes do rodapé. Somente em Sobre, Nail Art e Podologia. */
import IconWhatsapp from '../icons/IconWhatsapp.astro';
---

<section class="contact-strip" aria-labelledby="contact-strip-title">
  <div class="contact-strip__sparkles" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="container contact-strip__inner">
    <h2 id="contact-strip-title" class="contact-strip__title">Dúvidas ou precisa de ajuda?</h2>
    <button
      type="button"
      class="contact-strip__btn"
      data-booking
      data-booking-modo="duvida"
      data-booking-origem="faixa_contato"
    >
      <IconWhatsapp size={20} />
      Atendimento via WhatsApp
    </button>
  </div>
</section>

<style>
  .contact-strip {
    position: relative;
    overflow: hidden;
    padding-block: 40px;
    color: var(--color-white);
    background: var(--gradient-cta);
  }

  .contact-strip::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(224, 96, 154, 0.3), transparent 70%);
    pointer-events: none;
  }

  .contact-strip__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .contact-strip__title {
    font-size: 1.4rem;
    font-weight: 700;
  }

  .contact-strip__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 30px;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-purple);
    background: var(--color-white);
    border-radius: var(--radius-pill);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    transition: var(--transition);
  }

  .contact-strip__btn:hover {
    transform: translateY(-3px) scale(1.02);
    background: var(--color-neutral-bg);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
  }

  @media (min-width: 768px) {
    .contact-strip__inner {
      flex-direction: row;
      justify-content: center;
      gap: 32px;
    }

    .contact-strip__title {
      font-size: 1.6rem;
    }
  }

  .contact-strip__sparkles span {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-white);
    opacity: 0;
    animation: ctaSparkleBlink 3s infinite ease-in-out;
  }

  .contact-strip__sparkles span:nth-child(1) { top: 25%; left: 10%; animation-delay: 0s; }
  .contact-strip__sparkles span:nth-child(2) { top: 60%; left: 22%; animation-delay: 1.1s; }
  .contact-strip__sparkles span:nth-child(3) { top: 30%; right: 18%; animation-delay: 0.6s; }
  .contact-strip__sparkles span:nth-child(4) { bottom: 20%; right: 8%; animation-delay: 1.8s; }
  .contact-strip__sparkles span:nth-child(5) { top: 15%; right: 42%; animation-delay: 2.4s; }
</style>
