---
/**
 * Hero das páginas internas: a mesma moldura arredondada da Home, com o gradiente da marca
 * sempre em movimento. Trilha de navegação visível (o JSON-LD BreadcrumbList vem da página).
 * Com o slot "media", vira duas colunas no desktop (texto à esquerda, imagens à direita).
 * Slot "decor": camada decorativa sobre o gradiente (ex.: brilhos).
 */
interface Props {
  /** Etiqueta curta acima do título (só onde o briefing pede, ex.: "Nail Art"). */
  tag?: string;
  titulo: string;
  /** Nome da página na trilha (Início / nome). */
  trilha: string;
  /** A mídia encosta na borda inferior da moldura (ex.: grid de fotos em movimento). */
  midiaSangrada?: boolean;
}

const { tag, titulo, trilha, midiaSangrada = false } = Astro.props;
const comMidia = Astro.slots.has('media');
---

<section class="hero-internal" data-hero>
  <div
    class:list={[
      'hero-internal__frame',
      { 'hero-internal__frame--midia': comMidia, 'hero-internal__frame--sangrada': comMidia && midiaSangrada },
    ]}
  >
    <div class="gradiente-marca" aria-hidden="true"></div>
    <slot name="decor" />
    <div class="container hero-internal__grid">
      <div class="hero-internal__texto">
        <nav class="hero-internal__trilha" aria-label="Trilha de navegação">
          <a href="/">Início</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{trilha}</span>
        </nav>
        {tag && <span class="hero-internal__tag">{tag}</span>}
        <h1 class="hero-internal__title">{titulo}</h1>
        <slot />
      </div>
      {
        comMidia && (
          <div class="hero-internal__midia">
            <slot name="media" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-internal {
    padding: calc(var(--preview-h) + var(--frame-inset)) var(--frame-inset) 0;
    background-color: var(--color-white);
  }

  .hero-internal__frame {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-top: calc(var(--header-h) + 32px);
    padding-bottom: 56px;
    color: var(--color-purple);
    background-color: var(--color-blush);
    border-radius: 18px;
  }

  .hero-internal__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 40px;
    align-items: center;
  }

  /* min-width 0: trilhas largas (ex.: grid de fotos) não alargam a coluna */
  .hero-internal__midia {
    min-width: 0;
  }

  .hero-internal__texto {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
    animation: heroInternoEntra 1s var(--ease-out-expo) both;
  }

  .hero-internal__trilha {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 20px;
    font-size: 0.8125rem;
    color: var(--color-purple-dark);
  }

  .hero-internal__trilha a {
    text-decoration: underline;
    text-decoration-color: rgba(54, 33, 58, 0.35);
    text-underline-offset: 3px;
    transition: color 250ms var(--ease);
  }

  .hero-internal__trilha a:hover {
    color: var(--color-purple);
  }

  .hero-internal__tag {
    display: block;
    margin-bottom: 14px;
    font-size: 0.8125rem;
    font-style: italic;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-purple-dark);
  }

  .hero-internal__title {
    font-size: clamp(2.4rem, 5.4vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .hero-internal__texto :global(p) {
    max-width: 62ch;
    margin: 20px auto 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-purple-dark);
  }

  .hero-internal__texto :global(.hero-internal__acoes) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 24px;
    margin-top: 32px;
  }

  @keyframes heroInternoEntra {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @media (min-width: 768px) {
    .hero-internal__frame {
      padding-top: calc(var(--header-h) + 56px);
      padding-bottom: 88px;
      border-radius: 30px;
    }
  }

  /* Com imagens: texto à esquerda, imagens à direita */
  @media (min-width: 1024px) {
    .hero-internal__frame--midia .hero-internal__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 64px;
    }

    .hero-internal__frame--midia .hero-internal__texto {
      margin-inline: 0;
      text-align: left;
    }

    .hero-internal__frame--midia .hero-internal__trilha {
      justify-content: flex-start;
    }

    .hero-internal__frame--midia .hero-internal__texto :global(p) {
      margin-inline: 0;
    }

    .hero-internal__frame--midia .hero-internal__texto :global(.hero-internal__acoes) {
      justify-content: flex-start;
    }

    /* Mídia sangrada: ocupa a altura toda abaixo do header e encosta na borda inferior */
    .hero-internal__frame--sangrada {
      padding-bottom: 0;
    }

    .hero-internal__frame--sangrada .hero-internal__grid {
      align-items: stretch;
    }

    .hero-internal__frame--sangrada .hero-internal__texto {
      align-self: center;
      padding-bottom: 88px;
    }
  }

  /* Celular e tablet: a mídia sangrada encosta nas bordas da moldura */
  @media (max-width: 1023px) {
    .hero-internal__frame--sangrada {
      padding-bottom: 0;
    }

    .hero-internal__frame--sangrada .hero-internal__midia {
      margin-inline: calc(-1 * var(--gutter));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-internal__texto {
      animation: none;
    }
  }
</style>
