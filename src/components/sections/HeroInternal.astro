---
/** Hero das páginas internas: mais baixo que o da Home, com o mesmo gradiente animado. */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  tag?: string;
  titulo: string;
  /** Foto em baixa opacidade com mix-blend luminosity (opcional). */
  fundo?: ImageMetadata;
}

const { tag, titulo, fundo } = Astro.props;
const bg = fundo ? await getImage({ src: fundo, width: 1600, format: 'webp' }) : null;
---

<section class="hero-internal brand-gradient">
  {bg && <div class="hero-internal__bg" style={`background-image: url('${bg.src}')`} />}
  <div class="container hero-internal__content">
    {tag && <span class="hero-internal__tag">{tag}</span>}
    <h1 class="hero-internal__title">{titulo}</h1>
    <slot />
  </div>
</section>

<style>
  .hero-internal {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--header-h) + var(--preview-h) + 48px);
    padding-bottom: 56px;
    color: var(--color-white);
    text-align: center;
  }

  .hero-internal__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.12;
    mix-blend-mode: luminosity;
    pointer-events: none;
  }

  .hero-internal__content {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }

  .hero-internal__tag {
    display: inline-block;
    margin-bottom: 16px;
    padding: 6px 14px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background-color: rgba(107, 31, 124, 0.8);
    border: 1px solid rgba(161, 30, 93, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: var(--radius-20);
  }

  .hero-internal__title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .hero-internal__content :global(p) {
    margin-top: 20px;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.95);
  }

  @media (min-width: 768px) {
    .hero-internal {
      padding-top: calc(var(--header-h) + var(--preview-h) + 72px);
      padding-bottom: 80px;
    }

    .hero-internal__title {
      font-size: 2.75rem;
    }
  }
</style>
