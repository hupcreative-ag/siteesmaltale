---
/**
 * Hero das páginas internas: a mesma moldura arredondada e os tons claros do hero da Home,
 * mais baixo. O header fixo fica por cima da moldura.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  tag?: string;
  titulo: string;
  /** Foto em baixa opacidade, em tons de cinza (opcional). */
  fundo?: ImageMetadata;
}

const { tag, titulo, fundo } = Astro.props;
const bg = fundo ? await getImage({ src: fundo, width: 1600, format: 'webp' }) : null;
---

<section class="hero-internal" data-hero>
  <div class="hero-internal__frame brand-gradient">
    {bg && <div class="hero-internal__bg" style={`background-image: url('${bg.src}')`} />}
    <div class="container hero-internal__content">
      {tag && <span class="hero-internal__tag">{tag}</span>}
      <h1 class="hero-internal__title">{titulo}</h1>
      <slot />
    </div>
  </div>
</section>

<style>
  .hero-internal {
    padding: calc(var(--preview-h) + var(--frame-inset)) var(--frame-inset) 0;
    background-color: var(--color-white);
  }

  .hero-internal__frame {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-top: calc(var(--header-h) + 40px);
    padding-bottom: 56px;
    color: var(--color-purple);
    text-align: center;
    border-radius: 18px;
  }

  .hero-internal__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.1;
    mix-blend-mode: multiply;
    filter: grayscale(1);
    pointer-events: none;
  }

  .hero-internal__content {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }

  .hero-internal__tag {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 0.8125rem;
    font-style: italic;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-pink-dark);
  }

  .hero-internal__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero-internal__content :global(p) {
    margin-top: 20px;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #5b3d60;
  }

  @media (min-width: 768px) {
    .hero-internal__frame {
      padding-top: calc(var(--header-h) + 64px);
      padding-bottom: 80px;
      border-radius: 30px;
    }
  }
</style>
