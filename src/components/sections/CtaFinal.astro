---
/**
 * CTA final: moldura com o gradiente da marca em movimento, brilhos piscando e título com
 * "blur text" (as letras surgem do desfoque quando o bloco entra na tela).
 * Com `imagem` (recorte em PNG/WebP com transparência), vira duas colunas no desktop e a
 * pessoa "sai" da moldura por cima.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Brilhos from './Brilhos.astro';

interface Props {
  titulo: string;
  origem: string;
  rotulo?: string;
  imagem?: ImageMetadata;
  imagemAlt?: string;
}

const { titulo, origem, rotulo = 'Agende agora', imagem, imagemAlt = '' } = Astro.props;
const palavras = titulo.split(' ');
let i = 0;

const BRILHOS = imagem
  ? [
      { x: '6%', y: '20%', t: 18, d: 0 },
      { x: '12%', y: '82%', t: 12, d: 1.2 },
      { x: '44%', y: '14%', t: 10, d: 2.6 },
      { x: '56%', y: '72%', t: 16, d: 0.6 },
      { x: '92%', y: '30%', t: 14, d: 1.8 },
      { x: '88%', y: '80%', t: 10, d: 3.1 },
    ]
  : [
      { x: '8%', y: '22%', t: 18, d: 0 },
      { x: '16%', y: '72%', t: 12, d: 1.2 },
      { x: '86%', y: '18%', t: 14, d: 0.6 },
      { x: '92%', y: '64%', t: 20, d: 1.8 },
      { x: '74%', y: '86%', t: 10, d: 2.4 },
      { x: '28%', y: '12%', t: 9, d: 3 },
    ];
---

<section class="section section--white cta-final-wrap">
  <div class="container">
    <div class:list={['cta-final', { 'cta-final--imagem': imagem }]} data-reveal="fade">
      <div class="cta-final__fundo">
        <div class="gradiente-marca" aria-hidden="true"></div>
        <Brilhos itens={BRILHOS} />
      </div>

      <div class="cta-final__texto">
        <h2 class="cta-final__titulo">
          <span class="sr-only">{titulo}</span>
          <span aria-hidden="true">
            {
              palavras.map((p, n) => (
                <Fragment>
                  {n > 0 && ' '}
                  <span class="cta-final__palavra">
                    {[...p].map((c) => (
                      <span class="cta-final__letra" style={`--i:${i++}`}>
                        {c}
                      </span>
                    ))}
                  </span>
                </Fragment>
              ))
            }
          </span>
        </h2>
        <button type="button" class="specular-button specular-button--dark cta-final__botao" data-booking data-booking-origem={origem}>
          {rotulo}
        </button>
      </div>

      {
        imagem && (
          <Picture
            src={imagem}
            widths={[320, 480, 640, 910]}
            sizes="(min-width: 1024px) 420px, 300px"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            alt={imagemAlt}
            class="cta-final__pessoa"
            loading="lazy"
          />
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-final-wrap {
    padding-block: 32px 56px;
  }

  .cta-final {
    position: relative;
    isolation: isolate;
    padding: 72px 24px;
    text-align: center;
  }

  /* O fundo é recortado; a pessoa pode passar da borda de cima */
  .cta-final__fundo {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    isolation: isolate;
    border-radius: 24px;
  }

  .cta-final__texto {
    position: relative;
  }

  .cta-final__titulo {
    max-width: 18ch;
    margin: 0 auto 32px;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.08;
    color: var(--color-purple);
    text-wrap: balance;
  }

  .cta-final__palavra {
    display: inline-block;
    white-space: nowrap;
  }

  .cta-final__letra {
    display: inline-block;
  }

  /* ---------- Com imagem ---------- */
  .cta-final--imagem {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 0;
  }

  .cta-final--imagem :global(.cta-final__pessoa) {
    display: block;
    width: min(300px, 78%);
    height: auto;
    margin-top: 40px;
  }

  @media (min-width: 768px) {
    .cta-final-wrap {
      padding-block: 40px 80px;
    }

    .cta-final {
      padding: 104px 48px;
    }

    .cta-final__fundo {
      border-radius: 30px;
    }
  }

  /* Desktop: texto à esquerda, pessoa à direita saindo pela borda de cima */
  @media (min-width: 1024px) {
    /* Espaço só para a cabeça que passa da moldura */
    .cta-final-wrap:has(.cta-final--imagem) {
      padding-top: 100px;
    }

    .cta-final--imagem {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 48px;
      min-height: 420px;
      padding: 72px 0 0 80px;
      text-align: left;
    }

    .cta-final--imagem .cta-final__texto {
      flex: 1 1 0;
      padding-bottom: 72px;
    }

    .cta-final--imagem .cta-final__titulo {
      max-width: 14ch;
      margin-inline: 0;
    }

    .cta-final--imagem :global(.cta-final__pessoa) {
      flex: 0 0 auto;
      align-self: flex-end;
      width: 420px;
      margin: -136px 56px 0 0;
    }
  }

  /* Blur text: só anima com JS e movimento permitido */
  html.js .cta-final:not(.is-revealed) .cta-final__letra {
    opacity: 0;
    filter: blur(10px);
  }

  html.js .cta-final.is-revealed .cta-final__letra {
    animation: letraFoco 900ms var(--ease-out-expo) both;
    animation-delay: calc(var(--i) * 28ms);
  }

  @keyframes letraFoco {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(0.25em);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .cta-final .cta-final__letra {
      opacity: 1;
      filter: none;
      animation: none;
    }
  }
</style>
