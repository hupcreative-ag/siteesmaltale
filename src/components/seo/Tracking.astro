---
// GA4 e Meta Pixel em scripts separados. Só em produção.
// As filas (dataLayer e fbq) existem desde o início, então nenhum evento se perde, mas as
// bibliotecas só baixam depois do carregamento da página, quando o navegador fica ocioso.
// Carregadas cedo, elas atrasavam a foto do hero (LCP de 2,2 s para 7,9 s no celular).
import { IS_PRODUCTION } from '../../config/site';
import { TRACKING } from '../../config/tracking';

const { ga4, metaPixel } = TRACKING;
---

{
  IS_PRODUCTION && (
    <>
      <script is:inline define:vars={{ ga4 }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', ga4);

        (function (src) {
          function carregar() {
            var s = document.createElement('script');
            s.async = true;
            s.src = src;
            document.head.appendChild(s);
          }
          function quandoOcioso() {
            'requestIdleCallback' in window ? requestIdleCallback(carregar, { timeout: 2500 }) : setTimeout(carregar, 1200);
          }
          document.readyState === 'complete' ? quandoOcioso() : addEventListener('load', quandoOcioso, { once: true });
        })('https://www.googletagmanager.com/gtag/js?id=' + ga4);
      </script>
      <script is:inline define:vars={{ metaPixel }}>
        !(function (f, b, e, v, n) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = '2.0';
          n.queue = [];

          function carregar() {
            var t = b.createElement(e);
            t.async = !0;
            t.src = v;
            b.head.appendChild(t);
          }
          function quandoOcioso() {
            'requestIdleCallback' in f ? f.requestIdleCallback(carregar, { timeout: 2500 }) : setTimeout(carregar, 1200);
          }
          b.readyState === 'complete' ? quandoOcioso() : f.addEventListener('load', quandoOcioso, { once: true });
        })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', metaPixel);
        fbq('track', 'PageView');
      </script>
    </>
  )
}
